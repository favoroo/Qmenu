/**app.wxss**/
page {
  font-family: 'SF Pro Display', 'SF Pro Text', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
  font-size: 30rpx;
  color: #1D1D1F;
  background-color: #F2F2F7;
  box-sizing: border-box;
  --primary-color: #005BCB;
  --primary-light: #EBF2FB;
  --primary-dark: #004CAB;
  --primary-soft: #9CC4FA;
  --primary-tint: rgba(0, 91, 203, 0.08);
  --accent-color: #D4A373;
  --danger-color: #FF3B30;
  --warning-color: #FF9500;
  --success-color: #34C759;
  --text-main: #1D1D1F;
  --text-sub: #6E6E73;
  --text-light: #8E8E93;
  --bg-light: #F2F2F7;
  --border-color: #E5E5EA;
  --dock-bg: rgba(30, 30, 32, 0.85);
  --card-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04), 0 1rpx 4rpx rgba(0, 0, 0, 0.02);
  --btn-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  --radius-sm: 12rpx;
  --radius-md: 24rpx;
  --radius-lg: 48rpx;
  --radius-xl: 60rpx;
}

view, scroll-view, text, button, input, textarea {
  box-sizing: border-box;
}

icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  vertical-align: middle;
}

/* Common Layout Utilities */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
}

.justify-between {
  justify-content: space-between;
}

.justify-center {
  justify-content: center;
}

.align-center {
  align-items: center;
}

.flex-wrap {
  flex-wrap: wrap;
}

/* Margin and Padding */
.margin-top-sm { margin-top: 10rpx; }
.margin-top-md { margin-top: 20rpx; }
.margin-top-lg { margin-top: 30rpx; }
.margin-bottom-sm { margin-bottom: 10rpx; }
.margin-bottom-md { margin-bottom: 20rpx; }
.margin-bottom-lg { margin-bottom: 30rpx; }

/* Text Utilities */
.text-bold {
  font-weight: 600;
}

.text-main-color {
  color: var(--primary-color);
}

.text-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.text-desc {
  font-size: 24rpx;
  color: var(--text-sub);
}

.text-price {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--danger-color);
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* Card Style */
.card {
  background-color: #ffffff;
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

/* Button Styles */
.btn-primary {
  background: var(--primary-color);
  color: #ffffff;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  text-align: center;
  box-shadow: var(--btn-shadow);
  border: none;
  transition: all 0.2s ease;
}

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.btn-secondary {
  background-color: var(--primary-light);
  color: var(--primary-color);
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  text-align: center;
  border: none;
  transition: all 0.2s ease;
}

.btn-secondary:active {
  transform: scale(0.97);
  background-color: var(--primary-tint);
}

/* Form Styles */
.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background-color: var(--bg-light);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background-color: var(--bg-light);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

/* Global Animation Keyframes */
@keyframes stagger-rise {
  from { opacity: 0; transform: translateY(28rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes pop-in {
  0%   { opacity: 0; transform: scale(0.8); }
  60%  { transform: scale(1.04); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes badge-pop {
  0%   { transform: scale(1); }
  40%  { transform: scale(1.35); }
  100% { transform: scale(1); }
}

@keyframes float-soft {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-8rpx); }
}

/* Stagger entrance utility (JS-gated via .stagger class) */
.stagger {
  animation: stagger-rise 0.5s cubic-bezier(0.25, 1, 0.5, 1) backwards;
}

.stagger:nth-child(1) { animation-delay: 0.04s; }
.stagger:nth-child(2) { animation-delay: 0.08s; }
.stagger:nth-child(3) { animation-delay: 0.12s; }
.stagger:nth-child(4) { animation-delay: 0.16s; }
.stagger:nth-child(5) { animation-delay: 0.20s; }
.stagger:nth-child(6) { animation-delay: 0.24s; }
.stagger:nth-child(7) { animation-delay: 0.28s; }
.stagger:nth-child(8) { animation-delay: 0.32s; }
.stagger:nth-child(9) { animation-delay: 0.36s; }
.stagger:nth-child(10) { animation-delay: 0.40s; }

/* Global pulse timer animation */
@keyframes pulse-timer {
  0% { transform: scale(1); }
  50% { transform: scale(1.03); opacity: 0.85; }
  100% { transform: scale(1); }
}
