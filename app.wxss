/**app.wxss**/
page {
  font-family: 'SF Pro Display', 'SF Pro Text', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
  font-size: 28rpx;
  color: #333333;
  background-color: #F8FAFC;
  box-sizing: border-box;
  --primary-color: #2563EB;
  --primary-light: #EFF6FF;
  --primary-dark: #1D4ED8;
  --primary-soft: #DBEAFE;
  --primary-tint: rgba(37, 99, 235, 0.08);
  --accent-color: #D4A373;
  --danger-color: #E07A5F;
  --warning-color: #F4A261;
  --text-main: #1A1F2C;
  --text-sub: #5E6978;
  --text-light: #94A3B8;
  --bg-light: #F8FAFC;
  --border-color: #E2E8F0;
  --dock-bg: #0F1B3D;
  --card-shadow: 0 8rpx 30rpx rgba(15, 23, 42, 0.04), 0 2rpx 8rpx rgba(37, 99, 235, 0.04);
  --btn-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.22);
}

view, scroll-view, text, button, input, textarea {
  box-sizing: border-box;
}

icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  vertical-align: middle;
}

/* Common Layout Utilities */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
}

.justify-between {
  justify-content: space-between;
}

.justify-center {
  justify-content: center;
}

.align-center {
  align-items: center;
}

.flex-wrap {
  flex-wrap: wrap;
}

/* Margin and Padding */
.margin-top-sm { margin-top: 10rpx; }
.margin-top-md { margin-top: 20rpx; }
.margin-top-lg { margin-top: 30rpx; }
.margin-bottom-sm { margin-bottom: 10rpx; }
.margin-bottom-md { margin-bottom: 20rpx; }
.margin-bottom-lg { margin-bottom: 30rpx; }

/* Text Utilities */
.text-bold {
  font-weight: bold;
}

.text-main-color {
  color: var(--primary-color);
}

.text-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.text-desc {
  font-size: 24rpx;
  color: var(--text-sub);
}

.text-price {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--danger-color);
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* Card Style */
.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid rgba(37, 99, 235, 0.06);
}

/* Button Styles */
.btn-primary {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #ffffff;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  text-align: center;
  box-shadow: var(--btn-shadow);
  border: none;
  transition: all 0.2s ease;
}

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.18);
}

.btn-secondary {
  background-color: var(--primary-light);
  color: var(--primary-color);
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  text-align: center;
  border: none;
  transition: all 0.2s ease;
}

.btn-secondary:active {
  transform: scale(0.97);
  background-color: var(--primary-tint);
}

/* Form Styles */
.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background-color: var(--bg-light);
  border: 1rpx solid var(--border-color);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background-color: var(--bg-light);
  border: 1rpx solid var(--border-color);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

/* ==========================================================================
   Global Animation Keyframes
   ========================================================================== */
@keyframes stagger-rise {
  from { opacity: 0; transform: translateY(28rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes pop-in {
  0%   { opacity: 0; transform: scale(0.8); }
  60%  { transform: scale(1.04); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes badge-pop {
  0%   { transform: scale(1); }
  40%  { transform: scale(1.35); }
  100% { transform: scale(1); }
}

@keyframes float-soft {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-8rpx); }
}

/* Stagger entrance utility (JS-gated via .stagger class) */
.stagger {
  animation: stagger-rise 0.5s cubic-bezier(0.25, 1, 0.5, 1) backwards;
}

.stagger:nth-child(1) { animation-delay: 0.04s; }
.stagger:nth-child(2) { animation-delay: 0.08s; }
.stagger:nth-child(3) { animation-delay: 0.12s; }
.stagger:nth-child(4) { animation-delay: 0.16s; }
.stagger:nth-child(5) { animation-delay: 0.20s; }
.stagger:nth-child(6) { animation-delay: 0.24s; }
.stagger:nth-child(7) { animation-delay: 0.28s; }
.stagger:nth-child(8) { animation-delay: 0.32s; }
.stagger:nth-child(9) { animation-delay: 0.36s; }
.stagger:nth-child(10) { animation-delay: 0.40s; }
