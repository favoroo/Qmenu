.container {
  height: 100vh;
  background-color: var(--bg-light);
}

.discover-scroll {
  height: 100%;
  box-sizing: border-box;
}

/* Swiper Banners */
.banner-swiper {
  width: 100%;
  height: 380rpx;
  background-color: #ffffff;
}

.swiper-item-container {
  position: relative;
  width: 100%;
  height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  box-shadow: var(--card-shadow);
}

.banner-title-bg {
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
  right: 24rpx;
  height: 80rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.6), rgba(0,0,0,0));
  border-radius: 0 0 20rpx 20rpx;
}

.banner-title {
  position: absolute;
  bottom: 40rpx;
  left: 50rpx;
  right: 50rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Section Title */
.section-title {
  padding: 30rpx 36rpx 10rpx 36rpx;
}

.title-line {
  width: 8rpx;
  height: 32rpx;
  background-color: var(--primary-color);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
}

/* Articles List */
.articles-list {
  padding: 20rpx 24rpx;
}

.article-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

/* Author Row */
.author-row {
  margin-bottom: 20rpx;
}

.author-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  border: 2rpx solid var(--primary-light);
}

.author-name {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--text-main);
}

.publish-time {
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

/* Article Body */
.article-body {
  margin-bottom: 24rpx;
  gap: 20rpx;
}

.article-text-container {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.article-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
  line-height: 1.4;
  margin-bottom: 10rpx;
}

.article-summary {
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.5;
}

.article-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background-color: var(--bg-light);
}

/* Footer styling */
.article-footer {
  border-top: 1rpx solid var(--border-color);
  padding-top: 20rpx;
  font-size: 24rpx;
  color: var(--text-light);
}

.view-count {
  font-size: 24rpx;
}

.like-btn {
  font-size: 24rpx;
  color: var(--text-sub);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  background-color: var(--bg-light);
}

.like-btn .liked {
  color: #ff4d4f;
  font-weight: bold;
}
