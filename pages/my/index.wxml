<view class="container">
  <!-- 1. Profile Header Box -->
  <view class="profile-header flex-col align-center justify-center">
    <image class="profile-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
    <view class="profile-nickname">{{userInfo.nickName}}</view>
    <view class="profile-role-tag {{userInfo.role === 'admin' ? 'admin' : 'user'}}" bindtap="toggleRole">
      {{userInfo.role === 'admin' ? '管理员 (点击切换)' : '吃货用户 (点击切换)'}}
    </view>
  </view>

  <!-- 2. Options Menu Lists -->
  <view class="options-container">
    <!-- Admin Settings Section -->
    <view class="menu-section card" wx:if="{{userInfo.role === 'admin'}}">
      <view class="section-title">管理设置 (管理员可见)</view>
      
      <view class="menu-item flex-row justify-between align-center" bindtap="goCategoryManage">
        <view class="menu-item-left flex-row align-center">
          <icon type="info" size="18" color="#2D5A43" style="margin-right: 20rpx;"></icon>
          <text>分类管理</text>
        </view>
        <view class="arrow-right"></view>
      </view>

      <view class="menu-item flex-row justify-between align-center" bindtap="goRecipeAdd">
        <view class="menu-item-left flex-row align-center">
          <icon type="success" size="18" color="#2D5A43" style="margin-right: 20rpx;"></icon>
          <text>添加菜品</text>
        </view>
        <view class="arrow-right"></view>
      </view>
    </view>

    <!-- General Settings Section -->
    <view class="menu-section card">
      <view class="section-title">系统选项</view>

      <view class="menu-item flex-row justify-between align-center" bindtap="toggleRole">
        <view class="menu-item-left flex-row align-center">
          <icon type="search" size="18" color="#4caf50" style="margin-right: 20rpx;"></icon>
          <text>快速切换身份 (测试用)</text>
        </view>
        <view class="menu-item-right flex-row align-center">
          <text class="status-text">{{userInfo.role === 'admin' ? '管理员' : '普通吃货'}}</text>
          <view class="arrow-right"></view>
        </view>
      </view>

      <view class="menu-item flex-row justify-between align-center" bindtap="showAboutUs">
        <view class="menu-item-left flex-row align-center">
          <icon type="waiting" size="18" color="#4a5568" style="margin-right: 20rpx;"></icon>
          <text>关于 Q 菜单</text>
        </view>
        <view class="arrow-right"></view>
      </view>

      <view class="menu-item flex-row justify-between align-center" bindtap="resetCache">
        <view class="menu-item-left flex-row align-center">
          <icon type="warn" size="18" color="#ff4d4f" style="margin-right: 20rpx;"></icon>
          <text class="text-danger">恢复系统演示数据</text>
        </view>
        <view class="arrow-right"></view>
      </view>
    </view>
  </view>

  <!-- Footer Brand -->
  <view class="brand-footer flex-col align-center">
    <view class="brand-text">Q 菜单 © 2026</view>
    <view class="brand-subtext">世间万物，唯有美食不可辜负</view>
  </view>
</view>
