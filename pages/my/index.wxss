.container {
  min-height: 100vh;
  background-color: var(--bg-light);
  padding-bottom: 40rpx;
}

/* 1. Profile Header */
.profile-header {
  background: rgba(255,255,255,0.72);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 80rpx 40rpx;
  color: var(--text-main);
  border-radius: 0 0 48rpx 48rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.04);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.profile-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border-color);
  box-shadow: 0 0 0 6rpx rgba(0, 0, 0, 0.04), 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 24rpx;
  background-color: var(--bg-light);
}

.profile-nickname {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--text-main);
  margin-bottom: 0;
}


/* 2. Options List */
.options-container {
  padding: 30rpx 24rpx;
}

.menu-section {
  padding: 10rpx 30rpx !important;
  margin-bottom: 24rpx !important;
}

.section-title {
  font-size: 24rpx;
  font-weight: bold;
  color: var(--text-light);
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-item {
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  transition: all 0.2s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: var(--primary-tint);
}

.menu-item-left text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
}

.menu-item-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
  display: block;
}

.status-text {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-right: 12rpx;
}

.text-danger {
  color: var(--danger-color) !important;
}

/* Pure CSS Arrow Indicator */
.arrow-right {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--text-light);
  border-right: 3rpx solid var(--text-light);
  transform: rotate(45deg);
  transition: transform 0.2s ease;
}

.menu-item:active .arrow-right {
  transform: rotate(45deg) translateX(4rpx);
}

/* Brand Footer */
.brand-footer {
  margin-top: 60rpx;
  text-align: center;
}

.brand-text {
  font-size: 24rpx;
  color: var(--text-sub);
  font-weight: 600;
}

.brand-subtext {
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: 6rpx;
}

.edit-icon {
  font-size: 22rpx;
  color: var(--primary-color);
  margin-left: 12rpx;
  width: 40rpx;
  height: 40rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background-color: var(--primary-light);
  border-radius: 50%;
  transition: all 0.2s ease;
}

.profile-header:active .edit-icon {
  background-color: var(--primary-soft);
  transform: scale(0.92);
}

/* ===== 3. My Group Section ===== */
.my-groups-wrapper {
  padding: 0 24rpx;
  margin-bottom: 8rpx;
}

.my-group-card {
  padding: 10rpx 30rpx !important;
}

.current-group-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  transition: background-color 0.2s ease;
}

.current-group-row:active {
  background-color: var(--primary-tint);
}

.group-line1 {
  margin-bottom: 12rpx;
}

.my-group-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-right: 16rpx;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.role-tag.owner {
  background: var(--primary-light);
  color: var(--primary-color);
}

.role-tag.member {
  background: #f1f3f5;
  color: var(--text-sub);
}

.group-line2 {
  gap: 0;
}

.meta-text {
  font-size: 24rpx;
  color: var(--text-sub);
}

.meta-dot {
  margin: 0 10rpx;
  color: var(--text-light);
}

.invite-code-val {
  color: var(--primary-color);
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* Share Group Button */
.btn-share-group {
  margin: 24rpx 0 !important;
  width: 100% !important;
  background: var(--primary-color) !important;
  color: #fff !important;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--radius-lg) !important;
  padding: 22rpx 0 !important;
  border: none;
  box-shadow: var(--btn-shadow);
  transition: all 0.2s ease;
}

.btn-share-group::after {
  border: none !important;
}

.btn-share-group:active {
  transform: scale(0.98);
  opacity: 0.95;
}

.btn-share-group .share-icon {
  margin-right: 10rpx;
  font-size: 28rpx;
}

/* Group Action Row */
.group-action-row {
  gap: 20rpx;
  padding-bottom: 10rpx;
}

.group-action-btn {
  flex-shrink: 0;
  padding: 14rpx 32rpx !important;
  font-size: 26rpx !important;
  margin: 0 !important;
}

.manage-entry {
  flex: 1;
  padding: 14rpx 24rpx;
  background: var(--bg-light);
  border-radius: var(--radius-lg);
  transition: background-color 0.2s ease;
}

.manage-entry:active {
  background-color: var(--primary-tint);
}

.manage-entry text {
  font-size: 26rpx;
  color: var(--text-sub);
}

/* No Group State */
.no-group-box {
  padding: 30rpx 0 10rpx;
}

.no-group-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.no-group-text {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.no-group-desc {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-bottom: 28rpx;
  text-align: center;
  line-height: 1.5;
}

.no-group-actions {
  gap: 20rpx;
}

.no-group-actions button {
  padding: 16rpx 36rpx !important;
  font-size: 26rpx !important;
  margin: 0 !important;
}

/* ===== 4. Join Group Modal ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 1000;
}

.join-modal-card {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 82%;
  max-width: 600rpx;
  background-color: rgba(255, 255, 255, 0.98);
  border-radius: var(--radius-md);
  padding: 48rpx 40rpx;
  z-index: 1001;
}

.modal-close {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  font-size: 40rpx;
  color: var(--text-light);
  line-height: 1;
  padding: 10rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 12rpx;
  text-align: center;
}

.join-modal-subtitle {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 30rpx;
  text-align: center;
}

.join-input-row {
  width: 100%;
  margin-bottom: 36rpx;
}

.join-code-input {
  width: 100%;
  height: 88rpx;
  background-color: var(--bg-light);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: 34rpx;
  letter-spacing: 8rpx;
  text-align: center;
  color: var(--primary-color);
  font-weight: 600;
}

.join-modal-actions {
  width: 100%;
  gap: 20rpx;
}

.btn-modal-cancel {
  background: #f1f3f5;
  color: var(--text-sub);
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx 0;
  border: none;
  margin: 0 !important;
}

.btn-modal-cancel::after {
  border: none !important;
}

.btn-modal-confirm {
  background: var(--primary-color);
  color: #fff;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx 0;
  border: none;
  box-shadow: var(--btn-shadow);
  margin: 0 !important;
}

.btn-modal-confirm::after {
  border: none !important;
}

.scale-in {
  animation: modal-scale-in 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes modal-scale-in {
  from {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.8);
  }
  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}
