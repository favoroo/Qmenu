.container {
  min-height: 100vh;
  background-color: #f7fafc;
  padding-bottom: 40rpx;
}

/* 1. Profile Header */
.profile-header {
  background-color: #ffffff;
  padding: 80rpx 40rpx;
  color: var(--text-main);
  border-radius: 0 0 48rpx 48rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.02);
  border-bottom: 1rpx solid #F1F5F9;
}

.profile-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border-color);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 24rpx;
  background-color: var(--bg-light);
}

.profile-nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 0;
}


/* 2. Options List */
.options-container {
  padding: 30rpx 24rpx;
}

.menu-section {
  padding: 10rpx 30rpx !important;
  margin-bottom: 24rpx !important;
}

.section-title {
  font-size: 24rpx;
  font-weight: bold;
  color: var(--text-light);
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-item {
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-left text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
}

.status-text {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-right: 12rpx;
}

.text-danger {
  color: var(--danger-color) !important;
}

/* Pure CSS Arrow Indicator */
.arrow-right {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--text-light);
  border-right: 3rpx solid var(--text-light);
  transform: rotate(45deg);
}

/* Brand Footer */
.brand-footer {
  margin-top: 60rpx;
  text-align: center;
}

.brand-text {
  font-size: 24rpx;
  color: var(--text-sub);
  font-weight: 600;
}

.brand-subtext {
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: 6rpx;
}
