.container {
  min-height: 100vh;
  background-color: #f7fafc;
  padding-bottom: 40rpx;
}

/* 1. Profile Header */
.profile-header {
  background: linear-gradient(180deg, #EFF6FF 0%, #FFFFFF 100%);
  padding: 80rpx 40rpx;
  color: var(--text-main);
  border-radius: 0 0 48rpx 48rpx;
  box-shadow: 0 8rpx 30rpx rgba(37, 99, 235, 0.06);
  border-bottom: 1rpx solid rgba(37, 99, 235, 0.06);
}

.profile-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border-color);
  box-shadow: 0 0 0 6rpx rgba(37, 99, 235, 0.08), 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 24rpx;
  background-color: var(--bg-light);
}

.profile-nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 0;
}


/* 2. Options List */
.options-container {
  padding: 30rpx 24rpx;
}

.menu-section {
  padding: 10rpx 30rpx !important;
  margin-bottom: 24rpx !important;
}

.section-title {
  font-size: 24rpx;
  font-weight: bold;
  color: var(--text-light);
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-item {
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  transition: all 0.2s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: var(--primary-tint);
}

.menu-item-left text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
}

.menu-item-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
  display: block;
}

.status-text {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-right: 12rpx;
}

.text-danger {
  color: var(--danger-color) !important;
}

/* Pure CSS Arrow Indicator */
.arrow-right {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--text-light);
  border-right: 3rpx solid var(--text-light);
  transform: rotate(45deg);
  transition: transform 0.2s ease;
}

.menu-item:active .arrow-right {
  transform: rotate(45deg) translateX(4rpx);
}

/* Brand Footer */
.brand-footer {
  margin-top: 60rpx;
  text-align: center;
}

.brand-text {
  font-size: 24rpx;
  color: var(--text-sub);
  font-weight: 600;
}

.brand-subtext {
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: 6rpx;
}

.edit-icon {
  font-size: 22rpx;
  color: var(--primary-color);
  margin-left: 12rpx;
  width: 40rpx;
  height: 40rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background-color: var(--primary-light);
  border-radius: 50%;
  transition: all 0.2s ease;
}

.profile-header:active .edit-icon {
  background-color: var(--primary-soft);
  transform: scale(0.92);
}
