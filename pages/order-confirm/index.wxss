.container {
  height: 100vh;
  background-color: #f7fafc;
  position: relative;
}

.confirm-scroll {
  height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
  border-bottom: 1rpx solid var(--border-color);
  padding-bottom: 16rpx;
  margin-bottom: 20rpx;
}

/* Share banner */
.share-banner {
  background-color: var(--primary-light);
  border: 1rpx solid rgba(45, 90, 67, 0.2);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.share-banner-text {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: bold;
}

/* Dish List Breakdown styling */
.dish-item {
  padding: 20rpx 0;
  border-bottom: 1rpx dashed var(--border-color);
}

.dish-item:last-child {
  border-bottom: none;
}

.dish-image {
  width: 90rpx;
  height: 90rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  background-color: var(--bg-light);
}

.dish-name {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
}

.dish-qty {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 6rpx;
}

.dish-price {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
}

.fee-row {
  border-top: 1rpx solid var(--border-color);
  padding-top: 24rpx;
}

.fee-row .label {
  font-size: 26rpx;
  color: var(--text-sub);
}

.fee-row .value {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 600;
}

/* Remarks card styling */
.remark-textarea {
  height: 120rpx !important;
  font-size: 26rpx !important;
}

/* Sticky checkout footer */
.checkout-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background-color: #ffffff;
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.05);
  border-top: 1rpx solid var(--border-color);
  z-index: 100;
  padding: 0 40rpx;
}

.total-summary {
  display: flex;
  flex-direction: column;
}

.total-price-row .label {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-right: 8rpx;
}

.total-price-row .symbol {
  font-size: 26rpx;
  color: var(--danger-color);
  font-weight: bold;
  margin-right: 2rpx;
}

.total-price-row .price {
  font-size: 40rpx;
  color: var(--danger-color);
  font-weight: bold;
}

.total-summary .sub-tip {
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: 2rpx;
}

.btn-submit-order {
  padding: 20rpx 44rpx !important;
  font-size: 28rpx !important;
  border-radius: 40rpx;
  margin: 0;
  border: none;
  font-weight: bold;
}

.btn-submit-order.disabled {
  background: #cbd5e0 !important;
  box-shadow: none !important;
}
