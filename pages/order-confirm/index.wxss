.container {
  height: 100vh;
  background-color: var(--bg-light);
  position: relative;
}

.confirm-scroll {
  height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  border-bottom: 1rpx solid var(--border-color);
  padding-bottom: 16rpx;
  margin-bottom: 20rpx;
}

/* Share banner */
.share-banner {
  background-color: var(--primary-light);
  border: 1rpx solid rgba(0, 91, 203, 0.22);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.share-banner-text {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 600;
}

/* Dish List Breakdown styling */
.dish-item {
  padding: 20rpx 0;
  border-bottom: 1rpx dashed var(--border-color);
}

.dish-item:last-child {
  border-bottom: none;
}

.dish-image {
  width: 90rpx;
  height: 90rpx;
  border-radius: var(--radius-sm);
  margin-right: 20rpx;
  background-color: var(--bg-light);
}

.dish-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.dish-qty {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 6rpx;
}

.dish-price {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.dish-rating {
  margin-top: 8rpx;
  flex-wrap: wrap;
}

.dish-rating .rating-tag {
  font-size: 20rpx;
  color: var(--text-light);
  margin-right: 6rpx;
}

.dish-rating .rating-stars {
  font-size: 22rpx;
  line-height: 1;
}

.dish-rating .rating-delicious {
  color: var(--danger-color);
}

.dish-rating .rating-difficulty {
  color: var(--primary-color);
}

.dish-rating .rating-sep {
  margin: 0 10rpx;
  color: var(--text-light);
  font-size: 20rpx;
}

.fee-row {
  border-top: 1rpx solid var(--border-color);
  padding-top: 24rpx;
}

.fee-row .label {
  font-size: 26rpx;
  color: var(--text-sub);
}

.fee-row .value {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 600;
}

/* Remarks card styling */
.remark-textarea {
  height: 120rpx !important;
  font-size: 26rpx !important;
}

/* Sticky checkout footer */
.checkout-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background-color: #ffffff;
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.05);
  border-top: 1rpx solid var(--border-color);
  z-index: 100;
  padding: 0 40rpx;
}

.total-summary {
  display: flex;
  flex-direction: column;
}

.total-price-row .label {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-right: 8rpx;
}

.total-price-row .symbol {
  font-size: 26rpx;
  color: var(--danger-color);
  font-weight: 600;
  margin-right: 2rpx;
}

.total-price-row .price {
  font-size: 40rpx;
  color: var(--danger-color);
  font-weight: 600;
}

.total-summary .sub-tip {
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: 2rpx;
}

.btn-submit-order {
  padding: 20rpx 44rpx !important;
  font-size: 28rpx !important;
  border-radius: var(--radius-lg);
  margin: 0;
  border: none;
  font-weight: 600;
  background: var(--primary-color);
}

.btn-submit-order.disabled {
  background: #C7C7CC !important;
  box-shadow: none !important;
}

/* Chef Selection Card */
.chef-card {
  margin-bottom: 24rpx;
}

.chef-list {
  white-space: nowrap;
  padding: 8rpx 0 20rpx 0;
}

.chef-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
  padding: 12rpx 16rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--border-color);
  background-color: var(--bg-light);
  transition: all 0.25s ease;
  min-width: 120rpx;
}

.chef-item.active {
  border-color: var(--primary-color);
  background-color: var(--primary-light);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.chef-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-bottom: 10rpx;
  background-color: var(--border-color);
}

.chef-item.active .chef-avatar {
  border: 3rpx solid var(--primary-color);
}

.chef-name {
  font-size: 22rpx;
  color: var(--text-sub);
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chef-item.active .chef-name {
  color: var(--primary-color);
  font-weight: 600;
}

.chef-hint {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 8rpx;
  line-height: 1.4;
}
