<wxs module="stars">
  module.exports = {
    toStars: function(n) {
      n = n || 0;
      var s = '';
      var i;
      for (i = 0; i < n; i++) s += '★';
      for (i = n; i < 5; i++) s += '☆';
      return s;
    },
    hasRating: function(r) {
      return (r && r > 0);
    }
  };
</wxs>
<view class="container">
  <scroll-view class="confirm-scroll" scroll-y>
    <!-- 1. Share banner -->
    <view class="share-banner flex-row align-center" wx:if="{{isFromShare}}">
      <icon type="success" size="16" color="#007AFF" style="margin-right: 16rpx;"></icon>
      <text class="share-banner-text">您正在加入好友「{{sharerName}}」的拼单中！</text>
    </view>

    <!-- 2. Dish List Breakdown -->
    <view class="item-list-card card">
      <view class="card-title">菜品明细</view>
      
      <view class="dish-item flex-row align-center" wx:for="{{cartItems}}" wx:key="recipe.id">
        <image class="dish-image" src="{{item.recipe.image}}" mode="aspectFill"></image>
        <view class="dish-detail flex-1 flex-row justify-between align-center">
          <view class="dish-name-qty">
            <view class="dish-name">{{item.recipe.name}}</view>
            <view class="dish-rating flex-row align-center" wx:if="{{stars.hasRating(item.recipe.deliciousRating) || stars.hasRating(item.recipe.difficultyRating)}}">
              <block wx:if="{{stars.hasRating(item.recipe.deliciousRating)}}">
                <text class="rating-tag">美味</text>
                <text class="rating-stars rating-delicious">{{stars.toStars(item.recipe.deliciousRating)}}</text>
              </block>
              <text class="rating-sep" wx:if="{{stars.hasRating(item.recipe.deliciousRating) && stars.hasRating(item.recipe.difficultyRating)}}">·</text>
              <block wx:if="{{stars.hasRating(item.recipe.difficultyRating)}}">
                <text class="rating-tag">难度</text>
                <text class="rating-stars rating-difficulty">{{stars.toStars(item.recipe.difficultyRating)}}</text>
              </block>
            </view>
            <view class="dish-qty">x{{item.quantity}}</view>
          </view>
          <view class="dish-price">¥{{item.recipe.price * item.quantity}}</view>
        </view>
      </view>

      <!-- Delivery and Pricing Summary -->
      <view class="fee-row flex-row justify-between align-center margin-top-md">
        <text class="label">配送服务</text>
        <text class="value">私房直配 (免运费)</text>
      </view>
    </view>

    <!-- 3. Chef Selection -->
    <view class="chef-card card">
      <view class="card-title">指定厨师</view>
      <scroll-view class="chef-list" scroll-x>
        <view
          class="chef-item {{selectedChef && selectedChef.openid === m.openid ? 'active' : ''}}"
          wx:for="{{members}}"
          wx:for-item="m"
          wx:key="openid"
          bindtap="onSelectChef"
          data-openid="{{m.openid}}"
        >
          <image class="chef-avatar" src="{{m.avatarUrl || '/assets/images/default_avatar.png'}}" mode="aspectFill"></image>
          <text class="chef-name">{{m.nickName}}</text>
        </view>
      </scroll-view>
      <view class="chef-hint">默认由自己制作；选择其他成员将发送订阅消息提醒对方</view>
    </view>

    <!-- 4. Remarks Area -->
    <view class="remark-card card">
      <view class="card-title">备注信息</view>
      <textarea 
        class="form-textarea remark-textarea" 
        placeholder="写下您的口味偏好（如：不要辣、少放盐、不要香菜等）..." 
        value="{{remark}}" 
        bindinput="onRemarkInput"
        placeholder-class="input-placeholder"
        maxlength="100"
      />
    </view>
    
    <view style="height: 160rpx;"></view>
  </scroll-view>

  <!-- 4. Sticky Footer Checkout Dock -->
  <view class="checkout-footer flex-row align-center justify-between">
    <view class="total-summary flex-col">
      <view class="total-price-row">
        <text class="label">合计: </text>
        <text class="symbol">¥</text>
        <text class="price">{{cartTotal}}</text>
      </view>
      <text class="sub-tip">已免配送费</text>
    </view>
    <button 
      class="btn-primary btn-submit-order {{isSubmitting ? 'disabled' : ''}}" 
      bindtap="handlePlaceOrder"
      loading="{{isSubmitting}}"
      disabled="{{isSubmitting}}"
    >
      {{isFromShare ? '确认拼单并下单' : '提交订单'}}
    </button>
  </view>
</view>
