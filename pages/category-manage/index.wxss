.container {
  min-height: 100vh;
  background-color: #f7fafc;
  padding: 30rpx 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 24rpx;
}

.sub-tip {
  font-size: 20rpx;
  color: var(--text-light);
  font-weight: normal;
}

/* Form row styling */
.form-row {
  gap: 16rpx;
  align-items: stretch;
}

.name-input {
  height: 80rpx !important;
}

.btn-add {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 36rpx !important;
  font-size: 26rpx;
  margin: 0;
  box-shadow: none;
}

.btn-add::after {
  display: none;
}

.default-badge {
  font-size: 18rpx;
  color: var(--text-sub);
  background-color: var(--bg-light);
  border: 1px solid var(--border-color);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.delete-btn {
  font-size: 22rpx;
  color: var(--danger-color);
  background-color: #FAF2F0;
  border: 1rpx solid rgba(224, 122, 95, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  margin-left: 10rpx;
  font-weight: 500;
}

.delete-btn.disabled {
  color: var(--text-light);
  background-color: var(--bg-light);
  border-color: #edf2f7;
  opacity: 0.5;
}

/* Input Placeholder */
.input-placeholder {
  color: var(--text-light);
  font-size: 26rpx;
}

/* ============ Dish Management Mode ============ */
.dish-tip {
  font-size: 22rpx;
  color: var(--text-light);
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.dish-scroll {
  height: calc(100vh - 350rpx);
}

.dish-category-card {
  margin-bottom: 24rpx;
  transition: all 0.2s ease;
  border: 2rpx solid transparent;
}

.dish-category-card.dragging {
  opacity: 0.4;
}

.dish-category-card.drop-target-cat {
  border-color: var(--primary-color);
  background-color: var(--primary-light);
  box-shadow: 0 0 0 4rpx rgba(37, 99, 235, 0.15);
}

.dish-category-card.drop-target {
  border-color: var(--primary-color);
  background-color: var(--primary-light);
  box-shadow: 0 0 0 4rpx rgba(37, 99, 235, 0.1);
}

/* Category Grip Handle */
.cat-drag-handle {
  display: grid;
  grid-template-columns: repeat(2, 6rpx);
  grid-template-rows: repeat(3, 6rpx);
  gap: 6rpx;
  justify-content: center;
  align-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
}

.cat-grip-dot {
  width: 6rpx;
  height: 6rpx;
  background-color: var(--text-light);
  border-radius: 50%;
}

.dish-cat-header {
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.dish-cat-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
}

.dish-count-badge {
  font-size: 20rpx;
  color: var(--text-sub);
  background-color: var(--bg-light);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}

/* Dish row */
.dish-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  gap: 16rpx;
  transition: opacity 0.15s ease;
}

.dish-row.dragging {
  opacity: 0.3;
}

.dish-grip {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 32rpx;
  height: 40rpx;
  gap: 5rpx;
  flex-shrink: 0;
}

.dish-grip-bar {
  width: 26rpx;
  height: 4rpx;
  background-color: var(--text-light);
  border-radius: 2rpx;
}

.dish-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background-color: var(--bg-light);
}

.dish-name {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-price {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--danger-color);
  margin-right: 8rpx;
  flex-shrink: 0;
}

.dish-edit-btn {
  font-size: 22rpx;
  color: var(--primary-color);
  background-color: #EFF6FF;
  border: 1rpx solid rgba(37, 99, 235, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.dish-edit-btn:active {
  opacity: 0.7;
}

.dish-delete-btn {
  font-size: 22rpx;
  color: var(--danger-color);
  background-color: #FAF2F0;
  border: 1rpx solid rgba(224, 122, 95, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.dish-delete-btn:active {
  opacity: 0.7;
}

/* Add Recipe to Category Button */
.add-recipe-btn {
  margin-top: 20rpx;
  padding: 20rpx 0;
  border: 2rpx dashed var(--border-color);
  border-radius: 12rpx;
  background-color: #FAFBFC;
  gap: 8rpx;
}

.add-recipe-btn:active {
  background-color: var(--primary-light);
  border-color: var(--primary-color);
}

.add-recipe-plus {
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: bold;
}

.add-recipe-text {
  font-size: 26rpx;
  color: var(--text-sub);
}

.add-recipe-btn:active .add-recipe-text {
  color: var(--primary-color);
}

/* Floating Action Button - Add Recipe */
.fab-add-recipe {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 32rpx;
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.4);
  z-index: 100;
}

.fab-add-recipe:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.3);
}

.fab-plus {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
  line-height: 1;
}

.fab-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

.dish-empty {
  padding: 32rpx 0;
  font-size: 24rpx;
  color: var(--text-light);
}

/* ============ Floating Drag Element ============ */
.drag-float {
  position: fixed;
  transform: translate(-50%, -120%);
  background-color: var(--primary-color);
  color: #ffffff;
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
  z-index: 9999;
  pointer-events: none;
  gap: 16rpx;
  max-width: 60vw;
}

.drag-float-name {
  font-size: 28rpx;
  font-weight: 600;
  max-width: 300rpx;
}

.drag-float-price {
  font-size: 26rpx;
  font-weight: bold;
}

/* ============ Drop Indicator Line (fixed) ============ */
.drop-indicator-line {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  height: 6rpx;
  background-color: var(--primary-color);
  border-radius: 3rpx;
  z-index: 9998;
  pointer-events: none;
  box-shadow: 0 0 12rpx rgba(37, 99, 235, 0.45);
  transform: translateY(-3rpx);
}

.drop-indicator-line::before,
.drop-indicator-line::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: var(--primary-color);
  transform: translateY(-50%);
  box-shadow: 0 0 6rpx rgba(37, 99, 235, 0.45);
}

.drop-indicator-line::before { left: -7rpx; }
.drop-indicator-line::after { right: -7rpx; }
