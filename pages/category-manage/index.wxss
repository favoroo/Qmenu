.container {
  min-height: 100vh;
  background-color: #f7fafc;
  padding: 30rpx 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 24rpx;
}

.sub-tip {
  font-size: 20rpx;
  color: var(--text-light);
  font-weight: normal;
}

/* Form row styling */
.form-row {
  gap: 16rpx;
  align-items: stretch;
}

.name-input {
  height: 80rpx !important;
}

.btn-add {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 36rpx !important;
  font-size: 26rpx;
  margin: 0;
  box-shadow: none;
}

.btn-add::after {
  display: none;
}

/* Drag area */
.categories-drag-area {
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
}

.category-row {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  padding: 24rpx 0;
  background-color: #ffffff;
  border-bottom: 1rpx solid var(--border-color);
  box-sizing: border-box;
}

.cat-info {
  gap: 16rpx;
}

.cat-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.default-badge {
  font-size: 18rpx;
  color: var(--text-sub);
  background-color: var(--bg-light);
  border: 1px solid var(--border-color);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

/* Drag handle */
.drag-handle {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 32rpx;
  height: 48rpx;
  margin-right: 8rpx;
  gap: 6rpx;
}

.drag-handle-bar {
  width: 28rpx;
  height: 4rpx;
  background-color: var(--text-light);
  border-radius: 2rpx;
}

/* Delete button */
.cat-actions {
  gap: 10rpx;
}

.delete-btn {
  font-size: 22rpx;
  color: var(--danger-color);
  background-color: #FAF2F0;
  border: 1rpx solid rgba(224, 122, 95, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  margin-left: 10rpx;
  font-weight: 500;
}

.delete-btn.disabled {
  color: var(--text-light);
  background-color: var(--bg-light);
  border-color: #edf2f7;
  opacity: 0.5;
}

/* Input Placeholder */
.input-placeholder {
  color: var(--text-light);
  font-size: 26rpx;
}

/* ============ Mode Toggle Tabs ============ */
.mode-tabs {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-color);
  gap: 8rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-sub);
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.mode-tab.active {
  background-color: var(--primary-color);
  color: #ffffff;
  box-shadow: var(--btn-shadow);
}

/* ============ Dish Management Mode ============ */
.dish-tip {
  font-size: 22rpx;
  color: var(--text-light);
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.dish-scroll {
  height: calc(100vh - 220rpx);
}

.dish-category-card {
  margin-bottom: 24rpx;
  transition: all 0.2s ease;
  border: 2rpx solid transparent;
}

.dish-category-card.drop-target {
  border-color: var(--primary-color);
  background-color: var(--primary-light);
  box-shadow: 0 0 0 4rpx rgba(45, 90, 67, 0.1);
}

.dish-cat-header {
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.dish-cat-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
}

.dish-count-badge {
  font-size: 20rpx;
  color: var(--text-sub);
  background-color: var(--bg-light);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}

/* Dish row */
.dish-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  gap: 16rpx;
  transition: opacity 0.15s ease;
}

.dish-row.dragging {
  opacity: 0.3;
}

.dish-grip {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 32rpx;
  height: 40rpx;
  gap: 5rpx;
}

.dish-grip-bar {
  width: 26rpx;
  height: 4rpx;
  background-color: var(--text-light);
  border-radius: 2rpx;
}

.dish-name {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
}

.dish-price {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--danger-color);
  margin-right: 16rpx;
}

.dish-delete-btn {
  font-size: 22rpx;
  color: var(--danger-color);
  background-color: #FAF2F0;
  border: 1rpx solid rgba(224, 122, 95, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.dish-delete-btn:active {
  opacity: 0.7;
}

.dish-empty {
  padding: 32rpx 0;
  font-size: 24rpx;
  color: var(--text-light);
}

/* ============ Floating Drag Element ============ */
.drag-float {
  position: fixed;
  transform: translate(-50%, -120%);
  background-color: var(--primary-color);
  color: #ffffff;
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
  z-index: 9999;
  pointer-events: none;
  gap: 16rpx;
  max-width: 60vw;
}

.drag-float-name {
  font-size: 28rpx;
  font-weight: 600;
  max-width: 300rpx;
}

.drag-float-price {
  font-size: 26rpx;
  font-weight: bold;
}
