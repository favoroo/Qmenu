.container {
  min-height: 100vh;
  background-color: var(--bg-light);
  padding: 30rpx 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 24rpx;
}

.sub-tip {
  font-size: 20rpx;
  color: var(--text-light);
  font-weight: normal;
}

/* Form row styling */
.form-row {
  gap: 16rpx;
  align-items: stretch;
}

.name-input {
  height: 80rpx !important;
}

.btn-add {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 36rpx !important;
  font-size: 26rpx;
  margin: 0;
  box-shadow: none;
}

.btn-add::after {
  display: none;
}

.default-badge {
  font-size: 18rpx;
  color: var(--primary-color);
  background-color: var(--primary-light);
  border: 1rpx solid rgba(0, 91, 203, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
  font-weight: 500;
}

.delete-btn {
  font-size: 22rpx;
  color: var(--danger-color);
  background-color: #FAF2F0;
  border: 1rpx solid rgba(255, 59, 48, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  margin-left: 10rpx;
  font-weight: 500;
}

.delete-btn.disabled {
  color: var(--text-light);
  background-color: var(--bg-light);
  border-color: var(--border-color);
  opacity: 0.5;
}

/* Input Placeholder */
.input-placeholder {
  color: var(--text-light);
  font-size: 26rpx;
}

/* ============ Dish Management Mode ============ */
.dish-tip {
  font-size: 22rpx;
  color: var(--text-light);
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.dish-scroll {
  height: calc(100vh - 120rpx);
}

.dish-category-card {
  margin-bottom: 24rpx;
  transition: all 0.2s ease;
  border: 2rpx solid transparent;
}

.dish-category-card.dragging {
  opacity: 0.4;
}

.dish-category-card.drop-target-cat {
  border-color: var(--primary-color);
  background-color: var(--primary-light);
  box-shadow: 0 0 0 4rpx rgba(0, 91, 203, 0.12);
}

.dish-category-card.drop-target {
  border-color: var(--primary-color);
  background-color: var(--primary-light);
  box-shadow: 0 0 0 4rpx rgba(0, 91, 203, 0.08);
}

/* Category Grip Handle */
.cat-drag-handle {
  display: grid;
  grid-template-columns: repeat(2, 6rpx);
  grid-template-rows: repeat(3, 6rpx);
  gap: 6rpx;
  justify-content: center;
  align-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
}

.cat-grip-dot {
  width: 6rpx;
  height: 6rpx;
  background-color: var(--text-light);
  border-radius: 50%;
}

.dish-cat-header {
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.dish-cat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.dish-count-badge {
  font-size: 20rpx;
  color: var(--text-sub);
  background-color: var(--bg-light);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 16rpx;
}

/* Dish row */
.dish-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  gap: 16rpx;
  transition: opacity 0.15s ease;
}

.dish-row.dragging {
  opacity: 0.3;
}

.dish-grip {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 32rpx;
  height: 40rpx;
  gap: 5rpx;
  flex-shrink: 0;
}

.dish-grip-bar {
  width: 26rpx;
  height: 4rpx;
  background-color: var(--text-light);
  border-radius: 2rpx;
}

.dish-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background-color: var(--bg-light);
}

.dish-name {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-price {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--danger-color);
  margin-right: 8rpx;
  flex-shrink: 0;
}

.dish-edit-btn {
  font-size: 22rpx;
  color: var(--primary-color);
  background-color: var(--primary-light);
  border: 1rpx solid rgba(0, 91, 203, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.dish-edit-btn:active {
  opacity: 0.7;
}

.dish-delete-btn {
  font-size: 22rpx;
  color: var(--danger-color);
  background-color: #FAF2F0;
  border: 1rpx solid rgba(255, 59, 48, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.dish-delete-btn:active {
  opacity: 0.7;
}

/* Add Recipe to Category Button */
.add-recipe-btn {
  margin-top: 20rpx;
  padding: 20rpx 0;
  border: 2rpx dashed var(--border-color);
  border-radius: var(--radius-md);
  background-color: var(--bg-light);
  gap: 8rpx;
}

.add-recipe-btn:active {
  background-color: var(--primary-light);
  border-color: var(--primary-color);
}

.add-recipe-plus {
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: 600;
}

.add-recipe-text {
  font-size: 26rpx;
  color: var(--text-sub);
}

.add-recipe-btn:active .add-recipe-text {
  color: var(--primary-color);
}

/* Floating Action Button - Add Recipe */
.fab-add-recipe {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 32rpx;
  background: var(--primary-color);
  border-radius: var(--radius-lg);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 100;
}

.fab-add-recipe:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.fab-plus {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 600;
  line-height: 1;
}

.fab-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

.dish-empty {
  padding: 32rpx 0;
  font-size: 24rpx;
  color: var(--text-light);
}

/* ============ Floating Drag Element ============ */
.drag-float {
  position: fixed;
  transform: translate(-50%, -120%);
  background-color: var(--primary-color);
  color: #ffffff;
  padding: 16rpx 28rpx;
  border-radius: var(--radius-md);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
  z-index: 9999;
  pointer-events: none;
  gap: 16rpx;
  max-width: 60vw;
}

.drag-float-name {
  font-size: 28rpx;
  font-weight: 600;
  max-width: 300rpx;
}

.drag-float-price {
  font-size: 26rpx;
  font-weight: 600;
}

/* ============ Drop Indicator Line (fixed) ============ */
.drop-indicator-line {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  height: 6rpx;
  background-color: var(--primary-color);
  border-radius: 3rpx;
  z-index: 9998;
  pointer-events: none;
  box-shadow: 0 0 12rpx rgba(0, 91, 203, 0.35);
  transform: translateY(-3rpx);
}

.drop-indicator-line::before,
.drop-indicator-line::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: var(--primary-color);
  transform: translateY(-50%);
  box-shadow: 0 0 6rpx rgba(0, 91, 203, 0.35);
}

.drop-indicator-line::before { left: -7rpx; }
.drop-indicator-line::after { right: -7rpx; }

/* ============ Multi-select Mode Styles ============ */

/* Checkbox container for rows */
.row-checkbox-container {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 40rpx;
  flex-shrink: 0;
}

/* Custom Checkbox */
.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid var(--text-light);
  border-radius: 50%;
  position: relative;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  box-sizing: border-box;
  background-color: transparent;
}

.checkbox.checked {
  border-color: var(--primary-color);
  background-color: var(--primary-color);
  transform: scale(1.05);
}

.checkbox.checked::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 4rpx;
  width: 8rpx;
  height: 14rpx;
  border: solid #ffffff;
  border-width: 0 4rpx 4rpx 0;
  transform: rotate(45deg);
}

/* Dish row selections */
.dish-row.row-selecting {
  padding-left: 8rpx;
}

.dish-row.row-selected {
  background-color: rgba(0, 91, 203, 0.04);
  border-radius: var(--radius-sm);
  padding-left: 16rpx;
  padding-right: 16rpx;
}

/* Batch Action Bar at Bottom */
.batch-action-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(30rpx + env(safe-area-inset-bottom));
  height: 110rpx;
  background-color: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 30rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  padding: 0 32rpx;
  z-index: 1000;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  animation: slide-up-bar 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes slide-up-bar {
  from {
    transform: translateY(130%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.batch-action-left {
  gap: 20rpx;
}

.batch-select-all {
  gap: 12rpx;
  padding: 10rpx 0;
}

.select-all-text {
  font-size: 26rpx;
  color: var(--text-main);
  font-weight: 500;
}

.selected-count {
  font-size: 24rpx;
  color: var(--text-sub);
  border-left: 2rpx solid var(--border-color);
  padding-left: 20rpx;
}

.batch-action-right {
  gap: 16rpx;
}

.batch-btn {
  font-size: 26rpx;
  font-weight: 600;
  padding: 16rpx 36rpx;
  border-radius: var(--radius-md);
  transition: all 0.2s ease;
  line-height: 1.2;
}

.batch-btn-cancel {
  color: var(--text-sub);
  background-color: var(--bg-light);
}

.batch-btn-cancel:active {
  background-color: rgba(0, 0, 0, 0.05);
}

.batch-btn-delete {
  color: #ffffff;
  background-color: var(--danger-color);
  box-shadow: 0 4rpx 12rpx rgba(255, 59, 48, 0.2);
}

.batch-btn-delete.disabled {
  opacity: 0.35;
  background-color: #E5E5EA;
  color: var(--text-light);
  box-shadow: none;
  pointer-events: none;
}

.batch-btn-delete:not(.disabled):active {
  transform: translateY(1rpx);
  opacity: 0.9;
}
