.container {
  min-height: 100vh;
  background-color: #f7fafc;
  padding: 30rpx 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 24rpx;
}

.sub-tip {
  font-size: 20rpx;
  color: var(--text-light);
  font-weight: normal;
}

/* Form row styling */
.form-row {
  gap: 16rpx;
  align-items: stretch;
}

.name-input {
  height: 80rpx !important;
}

.btn-add {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 36rpx !important;
  font-size: 26rpx;
  margin: 0;
  box-shadow: none;
}

.btn-add::after {
  display: none;
}

/* Drag area */
.categories-drag-area {
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
}

.category-row {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  padding: 24rpx 0;
  background-color: #ffffff;
  border-bottom: 1rpx solid var(--border-color);
  box-sizing: border-box;
}

.cat-info {
  gap: 16rpx;
}

.cat-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.default-badge {
  font-size: 18rpx;
  color: var(--text-sub);
  background-color: var(--bg-light);
  border: 1px solid var(--border-color);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

/* Drag handle */
.drag-handle {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 32rpx;
  height: 48rpx;
  margin-right: 8rpx;
  gap: 6rpx;
}

.drag-handle-bar {
  width: 28rpx;
  height: 4rpx;
  background-color: var(--text-light);
  border-radius: 2rpx;
}

/* Delete button */
.cat-actions {
  gap: 10rpx;
}

.delete-btn {
  font-size: 22rpx;
  color: var(--danger-color);
  background-color: #FAF2F0;
  border: 1rpx solid rgba(224, 122, 95, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  margin-left: 10rpx;
  font-weight: 500;
}

.delete-btn.disabled {
  color: var(--text-light);
  background-color: var(--bg-light);
  border-color: #edf2f7;
  opacity: 0.5;
}

/* Input Placeholder */
.input-placeholder {
  color: var(--text-light);
  font-size: 26rpx;
}
