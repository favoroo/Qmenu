<view class="container">
  <!-- 1. Add Category Form -->
  <view class="add-section card">
    <view class="section-title">添加新分类</view>
    <view class="form-row flex-row">
      <input
        class="form-input flex-1 name-input"
        placeholder="分类名称，如：精品炒菜"
        value="{{newCatName}}"
        bindinput="onNameInput"
        placeholder-class="input-placeholder"
      />
      <button class="btn-primary btn-add" bindtap="handleAddCategory">添加</button>
    </view>
  </view>

  <!-- 2. Categories List -->
  <view class="list-section card">
    <view class="section-title flex-row justify-between">
      <text>分类列表</text>
      <text class="sub-tip">长按拖动可调整顺序</text>
    </view>

    <movable-area
      class="categories-drag-area"
      style="width: 100%; height: {{dragList.length > 0 ? dragList.length * itemHeight : 0}}px;"
    >
      <movable-view
        wx:for="{{dragList}}"
        wx:key="id"
        class="category-row flex-row justify-between align-center"
        style="width: 100%; height: {{itemHeight}}px; z-index: {{index == moveId ? 10 : 1}}; opacity: {{index == moveId ? 0.9 : 1}};"
        x="0"
        y="{{item.y}}"
        direction="vertical"
        damping="40"
        data-moveid="{{index}}"
        bindchange="onDragChange"
        bindtouchend="onDragEnd"
      >
        <view class="cat-info flex-row align-center">
          <view class="drag-handle">
            <view class="drag-handle-bar"></view>
            <view class="drag-handle-bar"></view>
            <view class="drag-handle-bar"></view>
          </view>
          <text class="cat-name">{{item.name}}</text>
          <text class="default-badge" wx:if="{{item.id === 'cat_default'}}">默认</text>
        </view>

        <view class="cat-actions flex-row align-center">
          <view
            class="delete-btn flex-row justify-center align-center {{item.id === 'cat_default' ? 'disabled' : ''}}"
            catchtap="handleDeleteCategory"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
          >
            删除
          </view>
        </view>
      </movable-view>
    </movable-area>
  </view>
</view>
