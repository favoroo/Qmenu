<view class="container">
  <view class="dish-tip">长按 ☰ 拖动菜品可排序或移动；长按 ⠿ 拖动可排序分类</view>

  <!-- 2. Categories & Dishes List -->
  <scroll-view class="dish-scroll" scroll-y>
    <view
      wx:for="{{categoryCards}}"
      wx:key="id"
      class="dish-category-card card {{draggingCategoryId === item.id ? 'dragging' : ''}} {{dragHighlightCatId === item.id ? 'drop-target-cat' : ''}} {{dragHighlightId === item.id ? 'drop-target' : ''}}"
    >
      <!-- Category Header -->
      <view class="dish-cat-header flex-row justify-between align-center">
        <view class="flex-row align-center">
          <!-- Category Drag Handle (⠿ Grip) -->
          <view
            class="cat-drag-handle"
            bindlongpress="onCategoryLongPress"
            catchtouchmove="onCategoryTouchMove"
            catchtouchend="onCategoryTouchEnd"
            data-category="{{item}}"
          >
            <view class="cat-grip-dot"></view>
            <view class="cat-grip-dot"></view>
            <view class="cat-grip-dot"></view>
            <view class="cat-grip-dot"></view>
            <view class="cat-grip-dot"></view>
            <view class="cat-grip-dot"></view>
          </view>
          <text class="dish-cat-name">{{item.name}}</text>
          <text class="dish-count-badge">{{item.recipes.length}}道</text>
          <text class="default-badge" wx:if="{{item.isDefault}}">默认</text>
        </view>
        
        <!-- Category Delete Button -->
        <view
          class="delete-btn flex-row justify-center align-center {{item.isDefault ? 'disabled' : ''}}"
          catchtap="{{item.isDefault ? '' : 'handleDeleteCategory'}}"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
        >删除</view>
      </view>

      <!-- Dishes List -->
      <block wx:if="{{item.recipes.length > 0}}">
        <view
          wx:for="{{item.recipes}}"
          wx:for-item="recipe"
          wx:key="id"
          class="dish-row flex-row align-center {{draggingRecipe.id === recipe.id ? 'dragging' : ''}}"
        >
          <view
            class="dish-grip"
            bindlongpress="onRecipeLongPress"
            catchtouchmove="onRecipeTouchMove"
            catchtouchend="onRecipeTouchEnd"
            data-recipe="{{recipe}}"
            data-catid="{{item.id}}"
          >
            <view class="dish-grip-bar"></view>
            <view class="dish-grip-bar"></view>
            <view class="dish-grip-bar"></view>
          </view>
          <image class="dish-thumb" src="{{recipe.image || '/assets/images/default_food.jpg'}}" mode="aspectFill"></image>
          <text class="dish-name flex-1 text-ellipsis">{{recipe.name}}</text>
          <text class="dish-price">¥{{recipe.price}}</text>
          <view
            class="dish-edit-btn"
            catchtap="handleEditRecipe"
            data-id="{{recipe.id}}"
          >编辑</view>
          <view
            class="dish-delete-btn"
            catchtap="handleDeleteRecipe"
            data-id="{{recipe.id}}"
            data-name="{{recipe.name}}"
          >删除</view>
        </view>
      </block>

      <view wx:else class="dish-empty flex-row align-center justify-center">
        <text>该分类暂无菜品</text>
      </view>

      <view class="add-recipe-btn flex-row align-center justify-center" catchtap="handleAddRecipeToCategory" data-catid="{{item.id}}">
        <text class="add-recipe-plus">+</text>
        <text class="add-recipe-text">添加菜品到该分类</text>
      </view>
    </view>

    <!-- 1. Add Category Section -->
    <view class="add-section card">
      <view class="section-title">添加新分类</view>
      <view class="form-row flex-row">
        <input
          class="form-input flex-1 name-input"
          placeholder="如：精品炒菜"
          value="{{newCatName}}"
          bindinput="onNameInput"
          placeholder-class="input-placeholder"
        />
        <button class="btn-primary btn-add" bindtap="handleAddCategory">添加</button>
      </view>
    </view>

    <view style="height: 180rpx;"></view>
  </scroll-view>
</view>

<!-- Floating Recipe drag element -->
<view
  class="drag-float flex-row align-center"
  wx:if="{{draggingRecipe}}"
  style="left: {{dragFloatX}}px; top: {{dragFloatY}}px;"
>
  <text class="drag-float-name text-ellipsis">{{draggingRecipe.name}}</text>
  <text class="drag-float-price">¥{{draggingRecipe.price}}</text>
</view>

<!-- Floating Category drag element -->
<view
  class="drag-float flex-row align-center"
  wx:if="{{draggingCategory}}"
  style="left: {{dragFloatX}}px; top: {{dragFloatY}}px; background-color: var(--primary-color);"
>
  <text class="drag-float-name text-ellipsis">{{draggingCategory.name}}</text>
</view>

<!-- Drop indicator line (fixed, no document flow impact) -->
<view
  class="drop-indicator-line"
  wx:if="{{draggingRecipe && dragHighlightId && dropIndicatorY > 0}}"
  style="top: {{dropIndicatorY}}px;"
></view>

<!-- Floating Add Recipe Button -->
<view class="fab-add-recipe" bindtap="handleAddRecipe">
  <text class="fab-plus">+</text>
  <text class="fab-text">新建菜品</text>
</view>
