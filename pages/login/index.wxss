.container {
  padding: 40rpx;
  background-color: var(--bg-light);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding-top: 120rpx;
}

.login-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  animation: pop-in 0.5s cubic-bezier(0.25, 1, 0.5, 1);
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
}

.title-badge {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  background: var(--primary-color);
  color: #ffffff;
  font-size: 56rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  animation: float-soft 4s infinite ease-in-out;
}

.title {
  font-size: 42rpx;
  font-weight: bold;
  color: var(--primary-color);
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 26rpx;
  color: var(--text-sub);
  text-align: center;
}

.form-group {
  margin-bottom: 60rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.avatar-picker-item {
  justify-content: center;
}

.label {
  font-size: 30rpx;
  color: var(--text-main);
  margin-bottom: 24rpx;
}

.avatar-wrapper {
  padding: 0;
  width: 120rpx !important;
  height: 120rpx !important;
  border-radius: 60rpx;
  background: none;
  margin: 0 !important;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
}

.input {
  width: 100%;
  font-size: 30rpx;
  color: var(--text-main);
  text-align: center;
}

.btn-submit {
  background: var(--primary-color);
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 500;
  padding: 20rpx 0;
  width: 100% !important;
}
