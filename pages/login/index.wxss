.container {
  padding: 40rpx;
  background-color: #f8fafc;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.login-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  animation: pop-in 0.5s cubic-bezier(0.25, 1, 0.5, 1);
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
}

.title-badge {
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #ffffff;
  font-size: 56rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.3);
  animation: float-soft 4s infinite ease-in-out;
}

.title {
  font-size: 42rpx;
  font-weight: bold;
  color: var(--primary-color);
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #64748B;
  text-align: center;
}

.form-group {
  margin-bottom: 60rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #E2E8F0;
}

.avatar-picker-item {
  justify-content: space-between;
}

.label {
  font-size: 30rpx;
  color: #334155;
  width: 120rpx;
}

.avatar-wrapper {
  padding: 0;
  width: 100rpx !important;
  height: 100rpx !important;
  border-radius: 50rpx;
  background: none;
  margin: 0 !important;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #334155;
}

.btn-submit {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 500;
  padding: 20rpx 0;
  width: 100% !important;
}
