.container {
  height: 100vh;
  background-color: var(--bg-light);
  display: flex;
  flex-direction: column;
}

/* Tab Bar */
.tab-bar {
  background-color: #ffffff;
  height: 88rpx;
  border-bottom: 1rpx solid var(--border-color);
  flex-shrink: 0;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-sub);
  font-weight: 500;
  position: relative;
  transition: color 0.2s ease;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: var(--primary-color);
  transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
}

/* Subscribe Banner */
.subscribe-banner {
  background-color: var(--primary-light);
  border: 1rpx solid rgba(0, 122, 255, 0.18);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin: 16rpx 24rpx 0 24rpx;
  flex-shrink: 0;
}

.banner-text {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.btn-subscribe {
  background-color: var(--primary-color);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.order-scroll {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.order-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  transition: all 0.2s ease;
}

/* Card Header */
.order-header {
  border-bottom: 1rpx solid var(--border-color);
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}

/* Order User Info Row Styles */
.order-user-row {
  padding: 12rpx 0;
  margin-bottom: 16rpx;
  border-bottom: 1rpx dashed var(--border-color);
  display: flex;
  align-items: center;
}

.order-user-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  margin-right: 12rpx;
}

.order-user-name {
  font-size: 26rpx;
  color: var(--text-main);
  font-weight: bold;
}

.order-user-tips {
  font-size: 22rpx;
  color: var(--text-light);
  margin-left: 10rpx;
}

.order-id {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
}

.order-time {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.order-status-badge {
  font-size: 24rpx;
  font-weight: bold;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
}

.order-status-badge.pending {
  color: var(--primary-color);
  background-color: var(--primary-light);
  border: 1rpx solid rgba(0, 122, 255, 0.22);
}

.order-status-badge.done {
  color: var(--text-sub);
  background-color: var(--bg-light);
  border: 1rpx solid var(--border-color);
}

/* Card Body (Items) */
.order-items-list {
  margin-bottom: 20rpx;
}

.order-item {
  padding: 16rpx 20rpx;
  margin: 0 -20rpx;
  border-bottom: 1rpx dashed var(--border-color);
  border-radius: 12rpx;
  transition: background-color 0.2s ease;
}

.order-item:last-child {
  border-bottom: none;
}

.order-item:active {
  background-color: var(--primary-tint);
}

.dish-image {
  width: 90rpx;
  height: 90rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
  background-color: var(--bg-light);
}

.dish-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.dish-qty {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.dish-price-arrow {
  display: flex;
  align-items: center;
}

.dish-price {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
}

.chevron-right {
  font-size: 36rpx;
  color: #94a3b8;
  margin-left: 12rpx;
  line-height: 1;
}

/* Remark styling */
.order-remark {
  background-color: var(--bg-light);
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid var(--primary-color);
}

.remark-label {
  color: var(--primary-color);
  font-weight: bold;
}

.remark-text {
  color: var(--text-sub);
}

/* Card Summary */
.order-summary {
  border-top: 1rpx solid var(--border-color);
  padding-top: 20rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.share-info-tag {
  color: var(--primary-color);
  font-weight: 600;
  background-color: var(--primary-light);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  display: flex;
  align-items: center;
}

.total-text {
  text-align: right;
}

.total-price {
  font-size: 32rpx;
  color: var(--danger-color);
  font-weight: bold;
}

/* Card Actions styling */
.order-actions {
  gap: 16rpx;
}

.btn-action-delete {
  font-size: 24rpx;
  color: var(--text-sub);
  background-color: #ffffff;
  border: 1px solid var(--border-color);
  border-radius: 30rpx;
  padding: 8rpx 28rpx;
  line-height: 1.5;
  margin: 0;
}

.btn-action-delete::after {
  display: none;
}

.btn-action-complete {
  font-size: 24rpx;
  color: #ffffff;
  background: var(--primary-color);
  border-radius: 30rpx;
  padding: 8rpx 28rpx;
  line-height: 1.5;
  margin: 0;
  font-weight: bold;
  box-shadow: var(--btn-shadow);
  border: none;
}

.btn-action-complete::after {
  display: none;
}

.btn-action-reorder {
  font-size: 24rpx;
  color: var(--primary-color);
  background-color: var(--primary-light);
  border: 1rpx solid var(--primary-color);
  border-radius: 30rpx;
  padding: 8rpx 28rpx;
  line-height: 1.5;
  margin: 0;
  font-weight: bold;
}

.btn-action-reorder::after {
  display: none;
}

/* Remind Chef Button */
.btn-action-remind {
  font-size: 24rpx;
  color: var(--primary-color);
  background-color: var(--primary-light);
  border: 1rpx solid var(--primary-color);
  border-radius: 30rpx;
  padding: 8rpx 28rpx;
  line-height: 1.5;
  margin: 0;
  font-weight: bold;
}

.btn-action-remind::after {
  display: none;
}

/* Chef Info Row */
.chef-row {
  padding: 12rpx 0;
  margin-bottom: 16rpx;
  border-bottom: 1rpx dashed var(--border-color);
}

.chef-row-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
}

.chef-row-label {
  font-size: 24rpx;
  color: var(--text-light);
}

.chef-row-name {
  font-size: 24rpx;
  color: var(--text-sub);
  font-weight: 600;
}

.chef-row-tag {
  font-size: 20rpx;
  color: #ffffff;
  background-color: var(--primary-color);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
  font-weight: bold;
}

/* Highlight for orders assigned to me (kitchen tab) */
.order-card.mine-to-cook {
  border-left: 6rpx solid var(--primary-color);
  background-color: rgba(0, 122, 255, 0.04);
}

/* Empty Orders view */
.empty-orders {
  flex: 1;
  padding: 40rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.empty-subtitle {
  font-size: 24rpx;
  color: var(--text-light);
}

/* 7. 菜谱详情弹窗 (Recipe Detail Modal & Timers) */
.detail-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(10px);
  z-index: 999;
  transition: all 0.3s ease;
}

.detail-popup-sheet {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 92vh;
  background-color: #ffffff;
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  z-index: 1000;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
}

.detail-close-btn {
  position: absolute;
  right: 32rpx;
  top: 32rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.3);
  color: #ffffff;
  font-size: 38rpx;
  z-index: 1010;
  font-weight: 300;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.15);
  transition: all 0.2s ease;
}

.detail-close-btn:active {
  background-color: rgba(0, 0, 0, 0.5);
  transform: scale(0.9);
}

.detail-content-scroll {
  width: 100%;
  height: 100%;
}

.detail-cover-image {
  width: 100%;
  height: 750rpx;
  aspect-ratio: 1 / 1;
  background-color: var(--bg-light);
}

.detail-info-container {
  padding: 40rpx 36rpx 80rpx 36rpx;
}

.detail-title-row {
  width: 100%;
}

.detail-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.3;
  letter-spacing: -0.02em;
}

.detail-category-badge {
  background-color: var(--primary-light);
  color: var(--primary-color);
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  margin-left: 20rpx;
  display: inline-block;
  white-space: nowrap;
}

.detail-price-row {
  color: var(--danger-color);
  font-weight: bold;
}

.detail-price-symbol {
  font-size: 28rpx;
  margin-right: 4rpx;
}

.detail-price-num {
  font-size: 44rpx;
}

.detail-divider {
  height: 1rpx;
  background-color: var(--border-color);
  margin: 36rpx 0;
  width: 100%;
}

.detail-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 20rpx;
}

.private-badge {
  font-size: 18rpx;
  color: var(--text-light);
  background-color: var(--bg-light);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: normal;
  border: 1rpx solid var(--border-color);
}

.detail-desc-box {
  width: 100%;
}

.detail-desc-text {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.5;
  display: block;
}

/* 用料表格样式 */
.detail-materials-table {
  width: 100%;
  background-color: var(--bg-light);
  border-radius: var(--radius-md);
  padding: 24rpx 30rpx;
  border: 1rpx solid var(--border-color);
}

.detail-material-row {
  width: 100%;
  padding: 18rpx 0;
  border-bottom: 1rpx dashed var(--border-color);
}

.detail-material-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.detail-material-row:first-child {
  padding-top: 0;
}

.detail-mat-name {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
}

.detail-mat-dots {
  border-bottom: 1rpx dotted rgba(148, 163, 184, 0.2);
  margin: 0 16rpx;
  height: 20rpx;
}

.detail-mat-weight {
  font-size: 28rpx;
  color: var(--text-sub);
  font-weight: 600;
}

/* 步骤时间轴样式 */
.detail-steps-timeline {
  width: 100%;
  margin-top: 10rpx;
}

.detail-step-timeline-item {
  width: 100%;
}

.timeline-left {
  position: relative;
  width: 50rpx;
  margin-right: 24rpx;
  align-self: stretch;
}

.timeline-node {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: var(--primary-color);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  z-index: 2;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

.timeline-line {
  position: absolute;
  top: 44rpx;
  bottom: 0;
  left: 21rpx;
  width: 2rpx;
  background-color: var(--border-color);
  z-index: 1;
}

.timeline-right {
  padding-bottom: 30rpx;
}

.timeline-step-header {
  width: 100%;
  height: 48rpx;
  display: flex;
  align-items: center;
}

.timeline-step-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
  line-height: 48rpx;
}

/* 交互烹饪定时器 */
.interactive-timer-btn {
  background-color: var(--primary-light);
  color: var(--primary-color);
  border: 1rpx solid rgba(0, 122, 255, 0.25);
  padding: 0 18rpx;
  height: 40rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  transition: all 0.25s ease;
  margin-left: auto;
  flex-shrink: 0;
  white-space: nowrap;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.interactive-timer-btn:active {
  transform: scale(0.95);
}

.timer-emoji {
  font-size: 22rpx;
  margin-right: 6rpx;
  line-height: 1;
}

.timer-btn-text {
  line-height: 1;
}

.interactive-timer-btn.running {
  background-color: rgba(255, 149, 0, 0.12);
  color: #FF9500;
  border-color: rgba(255, 149, 0, 0.3);
  animation: pulse-timer 1.5s infinite ease-in-out;
}

.interactive-timer-btn.finished {
  background-color: rgba(52, 199, 89, 0.12);
  color: #34C759;
  border-color: rgba(52, 199, 89, 0.3);
}


.timeline-step-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.5;
  display: block;
}

.timeline-step-image {
  width: 100%;
  border-radius: 16rpx;
  border: 1rpx solid var(--border-color);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

/* 8. 厨师星级排行榜 (Chef Ranking Card) */
.ranking-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin: 16rpx 24rpx 0 24rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  flex-shrink: 0;
}

.ranking-header {
  margin-bottom: 16rpx;
}

.ranking-title-row {
  gap: 12rpx;
}

.ranking-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
}

.ranking-sub {
  font-size: 20rpx;
  color: var(--text-light);
  background-color: var(--bg-light);
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
}

.ranking-period-tabs {
  gap: 8rpx;
}

.period-tab {
  font-size: 22rpx;
  color: var(--text-sub);
  background-color: var(--bg-light);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid transparent;
  transition: all 0.2s ease;
}

.period-tab.active {
  color: #ffffff;
  background-color: var(--primary-color);
  font-weight: bold;
}

.ranking-list {
  width: 100%;
}

.ranking-stats-row {
  background-color: var(--bg-light);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  justify-content: center;
  gap: 32rpx;
}

.ranking-stat-item {
  gap: 8rpx;
}

.ranking-stat-icon {
  font-size: 24rpx;
  line-height: 1;
}

.ranking-stat-num {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
  line-height: 1;
}

.ranking-stat-label {
  font-size: 20rpx;
  color: var(--text-light);
  line-height: 1;
}

.ranking-stat-divider {
  width: 1rpx;
  height: 28rpx;
  background-color: var(--border-color);
}

.ranking-item {
  padding: 14rpx 0;
  border-bottom: 1rpx dashed var(--border-color);
}

.ranking-item:last-child {
  border-bottom: none;
}

.rank-badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: var(--bg-light);
  color: var(--text-sub);
  font-size: 22rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
  border: 1rpx solid var(--border-color);
}

.rank-badge.rank-1 {
  background-color: #FEF3C7;
  color: #B45309;
  border-color: rgba(180, 83, 9, 0.25);
}

.rank-badge.rank-2 {
  background-color: #E5E7EB;
  color: #4B5563;
  border-color: rgba(75, 85, 99, 0.25);
}

.rank-badge.rank-3 {
  background-color: #FED7AA;
  color: #9A3412;
  border-color: rgba(154, 52, 18, 0.25);
}

.rank-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  margin-right: 16rpx;
  background-color: var(--bg-light);
  flex-shrink: 0;
}

.rank-info {
  min-width: 0;
}

.rank-name-row {
  margin-bottom: 6rpx;
}

.rank-name {
  font-size: 26rpx;
  color: var(--text-main);
  font-weight: 600;
  max-width: 280rpx;
}

.rank-stars-num {
  font-size: 30rpx;
  color: var(--danger-color);
  font-weight: bold;
}

.rank-meta-row {
  gap: 12rpx;
}

.rank-stars-bar {
  flex: 1;
  gap: 0;
}

.rank-star-cell {
  font-size: 16rpx;
  line-height: 1;
  color: var(--border-color);
  margin-right: 1rpx;
}

.rank-star-cell.filled {
  color: var(--danger-color);
}

.rank-meta {
  font-size: 20rpx;
  color: var(--text-light);
  flex-shrink: 0;
}

.ranking-empty {
  padding: 28rpx 0 16rpx 0;
  gap: 8rpx;
}

.ranking-empty-icon {
  font-size: 48rpx;
  margin-bottom: 4rpx;
  opacity: 0.5;
}

.ranking-empty-title {
  font-size: 26rpx;
  color: var(--text-sub);
  font-weight: bold;
}

.ranking-empty-desc {
  font-size: 22rpx;
  color: var(--text-light);
}

/* 9. 订单评分按钮与已评价徽章 (Rating Action & Rated Badge) */
.btn-action-rate {
  font-size: 24rpx;
  color: #ffffff;
  background: var(--danger-color);
  border-radius: 30rpx;
  padding: 8rpx 28rpx;
  line-height: 1.5;
  margin: 0;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(224, 122, 95, 0.25);
  border: none;
}

.btn-action-rate::after {
  display: none;
}

.rated-badge {
  display: flex;
  align-items: center;
  background-color: var(--bg-light);
  border: 1rpx solid var(--border-color);
  border-radius: 30rpx;
  padding: 6rpx 18rpx;
  gap: 4rpx;
}

.rated-badge-star {
  font-size: 22rpx;
  color: var(--danger-color);
  line-height: 1;
}

.rated-badge-num {
  font-size: 22rpx;
  color: var(--text-sub);
  font-weight: bold;
}

.chef-rated-badge {
  display: flex;
  align-items: center;
  background-color: #FEF3C7;
  border: 1rpx solid rgba(180, 83, 9, 0.2);
  border-radius: 30rpx;
  padding: 6rpx 18rpx;
  gap: 6rpx;
}

.chef-rated-star {
  font-size: 20rpx;
  line-height: 1;
}

.chef-rated-text {
  font-size: 22rpx;
  color: #B45309;
  font-weight: bold;
}

/* 10. 评分弹窗 (Rating Modal) */
.rating-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(6px);
  z-index: 1100;
}

.rating-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 620rpx;
  background-color: #ffffff;
  border-radius: var(--radius-md);
  padding: 40rpx 36rpx 32rpx 36rpx;
  z-index: 1101;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
  animation: rating-modal-in 0.25s cubic-bezier(0.25, 1, 0.5, 1);
}

@keyframes rating-modal-in {
  from { opacity: 0; transform: translate(-50%, -45%) scale(0.92); }
  to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
}

.rating-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
  text-align: center;
  margin-bottom: 24rpx;
}

.rating-chef-row {
  background-color: var(--bg-light);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 28rpx;
}

.rating-chef-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  margin-right: 20rpx;
  background-color: #ffffff;
  flex-shrink: 0;
}

.rating-chef-info {
  min-width: 0;
}

.rating-chef-name {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 4rpx;
}

.rating-chef-sub {
  font-size: 20rpx;
  color: var(--text-light);
}

.rating-stars-row {
  justify-content: space-between;
  padding: 0 4rpx;
  margin-bottom: 16rpx;
}

.rating-modal .rating-star-cell,
.rating-stars-row .rating-star-cell {
  font-size: 48rpx;
  line-height: 1;
  color: var(--border-color);
  padding: 8rpx 0;
  transition: color 0.15s ease, transform 0.15s ease;
}

.rating-stars-row .rating-star-cell.filled {
  color: var(--danger-color);
}

.rating-stars-row .rating-star-cell:active {
  transform: scale(1.15);
}

.rating-stars-value {
  text-align: center;
  font-size: 26rpx;
  color: var(--danger-color);
  font-weight: bold;
  margin-bottom: 28rpx;
}

.rating-stars-placeholder {
  color: var(--text-light);
  font-weight: normal;
  font-size: 24rpx;
}

.rating-modal-actions {
  gap: 20rpx;
  justify-content: space-between;
}

.btn-rating-cancel,
.btn-rating-submit {
  flex: 1;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 16rpx 0;
  line-height: 1.4;
  margin: 0;
  font-weight: bold;
}

.btn-rating-cancel {
  color: var(--text-sub);
  background-color: var(--bg-light);
  border: 1rpx solid var(--border-color);
}

.btn-rating-submit {
  color: #ffffff;
  background-color: var(--danger-color);
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(224, 122, 95, 0.3);
}

.btn-rating-cancel::after,
.btn-rating-submit::after {
  display: none;
}
