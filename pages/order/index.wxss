.container {
  height: 100vh;
  background-color: #f7fafc;
}

.order-scroll {
  height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

.order-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

/* Card Header */
.order-header {
  border-bottom: 1rpx solid var(--border-color);
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}

.order-id {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
}

.order-time {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.order-status-badge {
  font-size: 24rpx;
  font-weight: bold;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
}

.order-status-badge.pending {
  color: var(--primary-color);
  background-color: var(--primary-light);
  border: 1rpx solid rgba(45, 90, 67, 0.2);
}

.order-status-badge.done {
  color: var(--text-sub);
  background-color: var(--bg-light);
  border: 1rpx solid var(--border-color);
}

/* Card Body (Items) */
.order-items-list {
  margin-bottom: 20rpx;
}

.order-item {
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #edf2f7;
}

.order-item:last-child {
  border-bottom: none;
}

.dish-image {
  width: 90rpx;
  height: 90rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
  background-color: var(--bg-light);
}

.dish-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.dish-qty {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.dish-price {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
}

/* Remark styling */
.order-remark {
  background-color: var(--bg-light);
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid var(--primary-color);
}

.remark-label {
  color: var(--primary-color);
  font-weight: bold;
}

.remark-text {
  color: var(--text-sub);
}

/* Card Summary */
.order-summary {
  border-top: 1rpx solid var(--border-color);
  padding-top: 20rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.share-info-tag {
  color: var(--primary-color);
  font-weight: 600;
  background-color: var(--primary-light);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  display: flex;
  align-items: center;
}

.total-text {
  text-align: right;
}

.total-price {
  font-size: 32rpx;
  color: var(--danger-color);
  font-weight: bold;
}

/* Card Actions styling */
.order-actions {
  gap: 16rpx;
}

.btn-action-delete {
  font-size: 24rpx;
  color: var(--text-sub);
  background-color: #ffffff;
  border: 1px solid var(--border-color);
  border-radius: 30rpx;
  padding: 8rpx 28rpx;
  line-height: 1.5;
  margin: 0;
}

.btn-action-delete::after {
  display: none;
}

.btn-action-complete {
  font-size: 24rpx;
  color: #ffffff;
  background: var(--primary-color);
  border-radius: 30rpx;
  padding: 8rpx 28rpx;
  line-height: 1.5;
  margin: 0;
  font-weight: bold;
  box-shadow: var(--btn-shadow);
  border: none;
}

.btn-action-complete::after {
  display: none;
}

.btn-action-reorder {
  font-size: 24rpx;
  color: var(--primary-color);
  background-color: var(--primary-light);
  border: 1rpx solid var(--primary-color);
  border-radius: 30rpx;
  padding: 8rpx 28rpx;
  line-height: 1.5;
  margin: 0;
  font-weight: bold;
}

.btn-action-reorder::after {
  display: none;
}

/* Empty Orders view */
.empty-orders {
  height: 80vh;
  padding: 40rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.empty-subtitle {
  font-size: 24rpx;
  color: var(--text-light);
}
