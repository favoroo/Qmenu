.container {
  padding: 30rpx 24rpx;
  background-color: var(--bg-light);
  min-height: 100vh;
}

.no-group-box {
  background-color: #ffffff;
  padding: 60rpx 40rpx;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.02);
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary-soft) 100%);
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.no-group-box .title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.no-group-box .desc {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
  margin-bottom: 50rpx;
  padding: 0 20rpx;
}

.action-section {
  width: 100%;
}

.input-row {
  display: flex;
  margin-bottom: 24rpx;
}

.input {
  flex: 1;
  background-color: var(--bg-light);
  border-radius: var(--radius-sm);
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  text-align: left;
  color: var(--text-main);
}

.join-btn, .create-btn {
  width: 180rpx !important;
  height: 80rpx;
  font-size: 28rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx !important;
  border-radius: var(--radius-md);
}

.divider {
  font-size: 24rpx;
  color: var(--text-light);
  margin: 30rpx 0;
  position: relative;
}

.divider::before, .divider::after {
  content: "";
  position: absolute;
  top: 50%;
  width: 35%;
  height: 1rpx;
  background-color: var(--border-color);
}

.divider::before { left: 0; }
.divider::after { right: 0; }

/* Group Details */
.group-header {
  background-color: #ffffff;
  padding: 40rpx 30rpx;
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
}

.group-title {
  margin-bottom: 30rpx;
}

.group-title .name {
  font-size: 38rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.role-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.role-tag.owner {
  background-color: var(--primary-soft);
  color: var(--primary-color);
}

.role-tag.member {
  background-color: #DBEAFE;
  color: var(--primary-dark);
}

.invite-code-row {
  background-color: var(--bg-light);
  padding: 24rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 16rpx;
}

.code-lbl {
  font-size: 28rpx;
  color: var(--text-sub);
  flex-shrink: 1;
  margin-right: 16rpx;
}

.code-val {
  font-weight: bold;
  color: var(--primary-color);
  font-size: 32rpx;
}

.copy-btn {
  font-size: 24rpx;
  color: var(--primary-color);
  border: 1rpx solid var(--primary-color);
  background: none;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-sm);
  margin: 0 !important;
  line-height: 1.5;
  transition: all 0.2s ease;
}

.copy-btn:active {
  background-color: var(--primary-tint);
}

.share-tips {
  font-size: 22rpx;
  color: var(--text-light);
}

/* Members Section */
.members-section {
  background-color: #ffffff;
  padding: 30rpx;
  border-radius: var(--radius-md);
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.member-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.member-item:last-child {
  border-bottom: none;
}

.member-item .avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  margin-right: 20rpx;
}

.member-item .nickname {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
}

.identity-tag {
  font-size: 22rpx;
  color: var(--text-light);
}

.identity-tag.owner {
  color: var(--primary-color);
  font-weight: bold;
}

/* Footer Actions */
.action-footer {
  margin-top: 40rpx;
  padding: 0 20rpx;
}

.btn-danger {
  background-color: #EF4444;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 40rpx;
  padding: 20rpx 0;
  width: 100% !important;
  transition: all 0.2s ease;
}

.btn-danger:active {
  transform: scale(0.97);
}

.btn-danger-outline {
  background: none;
  border: 2rpx solid #EF4444;
  color: #EF4444;
  font-size: 30rpx;
  border-radius: 40rpx;
  padding: 20rpx 0;
  width: 100% !important;
  transition: all 0.2s ease;
}

.btn-danger-outline:active {
  transform: scale(0.97);
}

/* ===== 卡片点击态（全局 .card 已在 app.wxss 定义）===== */
.card-hover {
  background-color: var(--bg-light);
}

/* ===== 群组列表 ===== */
.group-list {
  margin-bottom: 30rpx;
}

.group-card {
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.card-name {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.card-meta {
  margin-top: 16rpx;
}

.meta-text {
  font-size: 24rpx;
  color: var(--text-light);
}

.current-tag {
  font-size: 22rpx;
  color: var(--primary-color);
  background-color: var(--primary-soft);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* ===== 返回按钮 ===== */
.back-row {
  margin-bottom: 24rpx;
}

.back-btn {
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* ===== 群主管理操作按钮 ===== */
.edit-btn {
  font-size: 26rpx;
  color: var(--primary-color);
  margin-right: 16rpx;
}

.regen-btn {
  font-size: 24rpx;
  color: #EF4444;
  margin-right: 16rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ===== 成员行操作 ===== */
.member-actions {
  gap: 20rpx;
}

.action-text {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.action-text.transfer {
  color: var(--primary-color);
  background-color: var(--primary-soft);
}

.action-text.remove {
  color: #EF4444;
  background-color: #FEF2F2;
}

/* ===== 分享群组按钮样式 ===== */
.btn-share-group {
  width: 100% !important;
  height: 88rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, #1D4ED8 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0 24rpx 0 !important;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(0, 91, 203, 0.25);
  transition: all 0.2s ease;
}

.btn-share-group:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.share-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}
