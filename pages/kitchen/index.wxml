<wxs module="stars">
  module.exports = {
    toStars: function(n) {
      n = n || 0;
      var s = '';
      var i;
      for (i = 0; i < n; i++) s += '★';
      for (i = n; i < 5; i++) s += '☆';
      return s;
    },
    hasRating: function(r) {
      return (r && r > 0);
    }
  };
</wxs>
<view class="container">
  <!-- Group Selector Header -->
  <view class="group-bar flex-row align-center" wx:if="{{groupsList.length > 1}}">
    <picker bindchange="onGroupChange" value="{{groupIndex}}" range="{{groupsList}}" range-key="name" class="group-picker-wrapper">
      <view class="group-picker flex-row align-center">
        <text class="group-name">{{currentGroup.name || '未加入群组'}}</text>
        <text class="arrow-down">▼</text>
      </view>
    </picker>
  </view>

  <!-- Chef Ranking Mini Bar (本月 Top 3) -->
  <view class="chef-ranking-bar flex-row align-center" wx:if="{{chefRanking.length > 0}}" bindtap="goToOrders">
    <view class="ranking-bar-label flex-row align-center">
      <text class="ranking-bar-icon">⭐</text>
      <text class="ranking-bar-text">星级榜</text>
    </view>
    <view class="ranking-bar-chefs flex-row align-center flex-1">
      <view class="ranking-bar-avatar-group flex-row" wx:for="{{chefRanking}}" wx:for-item="chef" wx:key="chefId">
        <image class="ranking-bar-avatar" src="{{chef.chefAvatar || '/assets/images/default_avatar.png'}}" mode="aspectFill" binderror="onImageError" data-type="avatar" data-id="{{chef.chefId}}"></image>
        <text class="ranking-bar-rank rank-{{index + 1}}">{{index + 1}}</text>
      </view>
    </view>
    <view class="ranking-bar-total flex-row align-center">
      <text class="ranking-bar-stars">{{chefRankingTotalStars}}</text>
      <text class="ranking-bar-arrow">›</text>
    </view>
  </view>

  <!-- 1. Header Section -->
  <view class="header-section">
    <!-- Search Bar -->
    <view class="search-bar-container">
      <view class="search-bar flex-row">
        <icon type="search" size="16" color="#a0aec0"></icon>
        <input class="search-input" placeholder="搜索菜谱..." value="{{searchQuery}}" bindinput="onSearchInput" placeholder-class="search-placeholder" />
        <icon type="clear" size="16" color="#cbd5e0" wx:if="{{searchQuery}}" bindtap="onSearchClear"></icon>
      </view>
    </view>
  </view>

  <!-- 当没有加入任何群组时显示空状态引导 -->
  <view wx:if="{{!currentGroup && !loading}}" class="empty-group flex-col align-center justify-center">
    <view class="empty-group-icon">👥</view>
    <view class="empty-group-title">您当前未加入任何群组</view>
    <view class="empty-group-desc">「Q 菜单」支持多用户协作。您可以创建自己专属的菜单群组，或者输入好友的邀请码加入已有群组。</view>
    <button class="btn-primary" bindtap="goGroupManage" style="width: 320rpx !important;">新建 / 加入群组</button>
  </view>

  <!-- 2. Dual Column Scroll Section -->
  <view class="main-content flex-row" wx:else>
    <!-- Skeleton Loading (首次无缓存时显示) -->
    <block wx:if="{{loading && categories.length === 0}}">
      <view class="skeleton-sidebar">
        <view class="skeleton-cat-item shimmer" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
      </view>
      <view class="skeleton-recipe-area flex-1">
        <view class="skeleton-title shimmer"></view>
        <view class="skeleton-recipe-card flex-row" wx:for="{{[1,2,3,4]}}" wx:key="*this">
          <view class="skeleton-img shimmer"></view>
          <view class="skeleton-info flex-1">
            <view class="skeleton-line shimmer w60"></view>
            <view class="skeleton-line shimmer w90" style="margin-top: 16rpx"></view>
            <view class="skeleton-line shimmer w30" style="margin-top: 16rpx"></view>
          </view>
        </view>
      </view>
    </block>

    <!-- Normal Content -->
    <block wx:else>
    <!-- Left Category Scroll -->
    <scroll-view class="category-sidebar" scroll-y scroll-with-animation>
      <view 
        class="category-item {{activeCategoryId === item.id ? 'active' : ''}}" 
        wx:for="{{categories}}" 
        wx:key="id" 
        bindtap="selectCategory" 
        data-id="{{item.id}}"
      >
        <text class="category-name text-ellipsis">{{item.name}}</text>
      </view>
      
      <!-- Category Management shortcut at the bottom -->
      <view class="category-manage-btn flex-row justify-center align-center" bindtap="goCategoryManage">
        <text class="manage-icon">⚙</text>
        <text>管理</text>
      </view>
    </scroll-view>

    <!-- Right Recipe Scroll -->
    <scroll-view class="recipe-list flex-1" scroll-y scroll-with-animation scroll-top="{{scrollTop}}" bindscroll="onRecipeScroll" refresher-enabled="{{true}}" refresher-triggered="{{refresherTriggered}}" bindrefresherrefresh="onRefresherRefresh">
      <block wx:for="{{groupedRecipes}}" wx:for-item="group" wx:key="categoryId">
        <view class="category-title-header" id="cat-{{group.categoryId}}">{{group.categoryName}}</view>
        
        <view class="recipes-container" wx:if="{{group.recipes.length > 0}}">
          <view class="recipe-card flex-row {{animReady ? 'stagger' : ''}}" wx:for="{{group.recipes}}" wx:for-item="item" wx:key="id" bindtap="showRecipeDetail" bindlongpress="onRecipeLongPress" data-recipe="{{item}}">
            <image class="recipe-image" src="{{item.image || '/assets/images/default_food.jpg'}}" mode="aspectFill" binderror="onImageError" data-type="recipe" data-id="{{item.id}}"></image>
            <view class="recipe-info flex-1 flex-col justify-between">
              <view>
                <view class="recipe-name flex-row align-center justify-between">
                  <text>{{item.name}}</text>
                  <text class="recipe-creator" wx:if="{{item.creatorName}}">By {{item.creatorName}}</text>
                </view>
                <view class="recipe-desc text-ellipsis-2">{{item.desc || '主人很懒，还没写这道菜的描述~'}}</view>
                <view class="recipe-rating flex-row align-center" wx:if="{{stars.hasRating(item.deliciousRating) || stars.hasRating(item.difficultyRating)}}">
                  <block wx:if="{{stars.hasRating(item.deliciousRating)}}">
                    <text class="rating-tag">美味</text>
                    <text class="rating-stars rating-delicious">{{stars.toStars(item.deliciousRating)}}</text>
                  </block>
                  <text class="rating-sep" wx:if="{{stars.hasRating(item.deliciousRating) && stars.hasRating(item.difficultyRating)}}">·</text>
                  <block wx:if="{{stars.hasRating(item.difficultyRating)}}">
                    <text class="rating-tag">难度</text>
                    <text class="rating-stars rating-difficulty">{{stars.toStars(item.difficultyRating)}}</text>
                  </block>
                </view>
              </view>
              <view class="recipe-bottom flex-row justify-between align-center">
                <view class="recipe-price">
                  <text class="price-symbol">¥</text>
                  <text class="price-num">{{item.price}}</text>
                </view>
                <!-- Add to Cart / Quantity adjust buttons -->
                <view class="quantity-controller flex-row align-center">
                  <view 
                    class="minus-btn" 
                    wx:if="{{cart[item.id]}}" 
                    catchtap="onSubtractCart" 
                    data-id="{{item.id}}"
                  ></view>
                  <text class="quantity-num" wx:if="{{cart[item.id]}}">{{cart[item.id].quantity}}</text>
                  <view 
                    class="plus-btn" 
                    catchtap="onAddCart" 
                    data-item="{{item}}"
                  ></view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- Empty category hint -->
        <view class="empty-category" wx:else>
          <text class="empty-category-text">该分类暂无菜品</text>
        </view>
      </block>
      
      <!-- Add Recipe Button at the bottom of the recipe list -->
      <view class="bottom-add-recipe-wrapper flex-row justify-center">
        <view class="btn-add-recipe-bottom flex-row align-center justify-center" bindtap="goRecipeAdd">
          <text class="add-icon">+</text> 添加菜谱
        </view>
      </view>

      <!-- Global Empty State -->
      <view class="empty-state flex-col align-center justify-center" wx:if="{{filteredRecipes.length === 0 && !loading}}">
        <icon type="search" size="48" color="#cbd5e0"></icon>
        <view class="empty-text">{{searchQuery ? '没有找到符合条件的菜谱哦' : '暂无菜谱'}}</view>
        <button class="btn-secondary margin-top-md" bindtap="goRecipeAdd">添加一道菜</button>
      </view>
      <view style="height: 160rpx;"></view> <!-- Bottom spacer -->
    </scroll-view>
    </block>
  </view>

  <!-- 3. Floating Random Wheel Button -->
  <view class="floating-random-btn flex-col justify-center align-center {{showCartPopup ? 'hidden' : ''}}" bindtap="openRandomModal" wx:if="{{currentGroup}}">
    <text class="random-icon">🎲</text>
    <text class="random-text">吃什么</text>
  </view>

  <!-- 4. Bottom Dock Cart Bar -->
  <view class="bottom-dock-container flex-row align-center" wx:if="{{cartCount > 0}}">
    <view class="cart-icon-wrapper flex-row align-center" bindtap="toggleCartPopup">
      <view class="cart-icon-bg flex-row justify-center align-center">
        <image class="cart-icon-img" src="/assets/tabbar/kitchen_active.png" mode="aspectFit"></image>
        <view class="cart-badge {{badgeBump ? 'bump' : ''}}">{{cartCount}}</view>
      </view>
      <view class="cart-price-info">
        <view class="cart-total-price">
          <text class="symbol">¥</text>{{cartTotal}}
        </view>
        <view class="cart-subtext">免费配送</view>
      </view>
    </view>

    <view class="cart-action-buttons flex-row">
      <button class="btn-share-invite flex-row align-center justify-center" open-type="share">
        邀请好友下单
      </button>
      <button class="btn-checkout flex-row align-center justify-center" bindtap="goToConfirmOrder">
        下单
      </button>
    </view>
  </view>

  <!-- 5. Cart Popup Drawer (Overlay & Sheet) -->
  <view class="overlay" wx:if="{{showCartPopup}}" bindtap="toggleCartPopup"></view>
  <view class="cart-popup-sheet {{showCartPopup ? 'slide-up' : ''}}" wx:if="{{showCartPopup}}">
    <view class="cart-sheet-header flex-row justify-between align-center">
      <view class="title flex-row align-center">
        <text class="text-bold">已选菜品</text>
        <text class="sub-count">(共 {{cartCount}} 件)</text>
      </view>
      <view class="clear-btn flex-row align-center" bindtap="clearCart">
        <icon type="clear" size="14" color="#a0aec0" style="margin-right: 6rpx;"></icon>
        <text>清空</text>
      </view>
    </view>
    
    <scroll-view class="cart-items-scroll" scroll-y>
      <view class="cart-item flex-row justify-between align-center" wx:for="{{cart}}" wx:key="key">
        <view class="item-name-desc">
          <view class="name">{{item.recipe.name}}</view>
          <view class="price">¥{{item.recipe.price}}</view>
        </view>
        <view class="quantity-controller flex-row align-center">
          <view class="minus-btn" bindtap="onSubtractCart" data-id="{{item.recipe.id}}"></view>
          <text class="quantity-num">{{item.quantity}}</text>
          <view class="plus-btn" bindtap="onAddCart" data-item="{{item.recipe}}"></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 6. Random Dish Selection Modal -->
  <view class="modal-overlay" wx:if="{{showRandomModal}}" bindtap="closeRandomModal"></view>
  <view class="random-modal-card flex-col align-center {{showRandomModal ? 'scale-in' : ''}}" wx:if="{{showRandomModal}}">
    <view class="modal-close" bindtap="closeRandomModal">×</view>
    <view class="modal-title">{{randomCount === 1 ? '纠结吃什么？帮你挑一个！' : '纠结吃什么？帮你挑' + randomCount + '个！'}}</view>
    
    <!-- Selector for random count -->
    <view class="random-count-selector flex-row align-center justify-center">
      <text class="selector-label">选择菜数：</text>
      <view class="selector-options flex-row">
        <view class="selector-option {{randomCount === 1 ? 'active' : ''}}" bindtap="setRandomCount" data-count="1">1</view>
        <view class="selector-option {{randomCount === 2 ? 'active' : ''}}" bindtap="setRandomCount" data-count="2">2</view>
        <view class="selector-option {{randomCount === 3 ? 'active' : ''}}" bindtap="setRandomCount" data-count="3">3</view>
        <view class="selector-option {{randomCount === 4 ? 'active' : ''}}" bindtap="setRandomCount" data-count="4">4</view>
      </view>
    </view>

    <!-- Category filter -->
    <view class="random-category-section">
      <view class="random-category-header flex-row align-center justify-between">
        <text class="selector-label">选择分类：</text>
        <view class="random-category-toggle {{isRolling ? 'disabled' : ''}}" bindtap="toggleAllRandomCategories">
          {{randomAllSelected ? '取消全选' : '全选'}}
        </view>
      </view>
      <view class="random-category-chips flex-row flex-wrap">
        <view 
          class="random-category-chip {{item.selected ? 'active' : ''}} {{isRolling ? 'disabled' : ''}}" 
          wx:for="{{randomCategoryList}}" 
          wx:key="id"
          bindtap="toggleRandomCategory"
          data-id="{{item.id}}"
        >
          {{item.name}}
        </view>
      </view>
      <view class="random-pool-count">共 {{randomPoolCount}} 个菜品可选</view>
    </view>

    <view class="rolling-box flex-col align-center justify-center">
      <view class="rolling-list {{randomCount > 1 ? 'grid-' + randomCount : 'single-layout'}}">
        <view class="rolling-item flex-col align-center justify-center" wx:for="{{rollingRecipes}}" wx:key="id">
          <image class="rolling-image {{isRolling ? 'rotate-animation' : ''}}" src="{{item.image || '/assets/images/default_food.jpg'}}" mode="aspectFill" binderror="onRollingImageError" data-index="{{index}}"></image>
          <view class="rolling-name {{isRolling ? 'rolling-text' : ''}}">{{item.name}}</view>
        </view>
      </view>
    </view>

    <button 
      class="btn-roll-trigger {{isRolling || randomPoolCount === 0 ? 'disabled' : ''}}" 
      bindtap="startRandomRoll" 
      disabled="{{isRolling || randomPoolCount === 0}}"
    >
      {{isRolling ? '挑选美食中...' : (randomPoolCount === 0 ? '暂无可选菜品' : '帮我选 ' + randomCount + ' 个！')}}
    </button>

    <button 
      class="btn-roll-confirm" 
      wx:if="{{randomSelectedRecipes.length > 0 && !isRolling}}" 
      bindtap="addRandomToCart"
    >
      {{randomCount === 1 ? '就吃这个，加购物车！' : '就要这些，加购物车！'}}
    </button>
  </view>

  <!-- 7. Recipe Detail Modal (Overlay & Sheet) -->
  <view class="detail-overlay" wx:if="{{showDetailModal}}" bindtap="closeRecipeDetail"></view>
  <view class="detail-popup-sheet flex-col {{showDetailModal ? 'slide-up' : ''}}" wx:if="{{showDetailModal}}">
    <block wx:if="{{selectedRecipe}}">
      <!-- Close Button -->
      <view class="detail-close-btn flex-row justify-center align-center" bindtap="closeRecipeDetail">×</view>
      
      <!-- Scrollable content -->
      <scroll-view class="detail-content-scroll flex-1" scroll-y>
        <!-- Cover Image -->
        <image class="detail-cover-image" src="{{selectedRecipe.image || '/assets/images/default_food.jpg'}}" mode="aspectFill" binderror="onImageError" data-type="recipe" data-id="{{selectedRecipe.id}}"></image>
        
        <view class="detail-info-container">
          <!-- Title and Category badge -->
          <view class="detail-title-row flex-row align-center justify-between">
            <view class="flex-row align-center wrap">
              <text class="detail-name">{{selectedRecipe.name}}</text>
              <text class="detail-category-badge">{{selectedRecipeCategoryName}}</text>
            </view>
            <view class="detail-edit-btn flex-row align-center" wx:if="{{isAdmin}}" catchtap="goRecipeEdit" data-id="{{selectedRecipe.id}}">
              <text class="edit-icon">✏️</text>
              <text class="edit-text">编辑</text>
            </view>
          </view>
          
          <!-- Price -->
          <view class="detail-price-row margin-top-sm">
            <text class="detail-price-symbol">¥</text>
            <text class="detail-price-num">{{selectedRecipe.price}}</text>
          </view>

          <!-- Rating -->
          <view class="detail-rating flex-col" wx:if="{{stars.hasRating(selectedRecipe.deliciousRating) || stars.hasRating(selectedRecipe.difficultyRating)}}">
            <view class="detail-rating-row flex-row align-center" wx:if="{{stars.hasRating(selectedRecipe.deliciousRating)}}">
              <text class="detail-rating-label">美味程度</text>
              <text class="detail-rating-stars rating-delicious">{{stars.toStars(selectedRecipe.deliciousRating)}}</text>
              <text class="detail-rating-num">{{selectedRecipe.deliciousRating}}/5</text>
            </view>
            <view class="detail-rating-row flex-row align-center" wx:if="{{stars.hasRating(selectedRecipe.difficultyRating)}}">
              <text class="detail-rating-label">制作难度</text>
              <text class="detail-rating-stars rating-difficulty">{{stars.toStars(selectedRecipe.difficultyRating)}}</text>
              <text class="detail-rating-num">{{selectedRecipe.difficultyRating}}/5</text>
            </view>
          </view>

          <!-- Description -->
          <view class="detail-desc-box margin-top-md" wx:if="{{selectedRecipe.desc}}">
            <view class="detail-section-title">菜品介绍</view>
            <text class="detail-desc-text">{{selectedRecipe.desc}}</text>
          </view>
          
          <!-- Ingredients (用料) -->
          <block wx:if="{{selectedRecipe.hasMaterialStep && selectedRecipe.materials && selectedRecipe.materials.length > 0 && (selectedRecipe.materialsPublic || isAdmin)}}">
            <view class="detail-divider"></view>
            <view class="detail-section-title flex-row align-center justify-between">
              <text>食材清单</text>
              <text class="private-badge" wx:if="{{!selectedRecipe.materialsPublic}}">仅自己可见</text>
            </view>
            
            <view class="detail-materials-table">
              <view class="detail-material-row flex-row justify-between align-center" wx:for="{{selectedRecipe.materials}}" wx:key="index">
                <text class="detail-mat-name">{{item.name}}</text>
                <view class="detail-mat-dots flex-1"></view>
                <text class="detail-mat-weight">{{item.weight}}</text>
              </view>
            </view>
          </block>
          
          <!-- Cooking Steps (做法) -->
          <block wx:if="{{selectedRecipe.hasMaterialStep && selectedRecipe.steps && selectedRecipe.steps.length > 0 && (selectedRecipe.stepsPublic || isAdmin)}}">
            <view class="detail-divider"></view>
            <view class="detail-section-title flex-row align-center justify-between">
              <text>烹饪步骤</text>
              <text class="private-badge" wx:if="{{!selectedRecipe.stepsPublic}}">仅自己可见</text>
            </view>
            
            <view class="detail-steps-timeline">
              <view class="detail-step-timeline-item flex-row align-start" wx:for="{{selectedRecipe.steps}}" wx:key="index">
                <!-- Left index and line -->
                <view class="timeline-left flex-col align-center">
                  <view class="timeline-node flex-row justify-center align-center">{{index + 1}}</view>
                  <view class="timeline-line" wx:if="{{index < selectedRecipe.steps.length - 1}}"></view>
                </view>
                
                <!-- Right content -->
                <view class="timeline-right flex-col flex-1 margin-bottom-lg">
                  <!-- Step Timer -->
                  <view class="timeline-step-header flex-row justify-between align-center" wx:if="{{item.timer > 0}}">
                    <text class="timeline-step-title">步骤 {{index + 1}}</text>
                    <!-- Interactive Timer Badge -->
                    <view 
                      class="interactive-timer-btn flex-row align-center {{activeTimerStepIndex === index ? (timerSecondsLeft > 0 ? 'running' : 'finished') : ''}}" 
                      catchtap="toggleStepTimer" 
                      data-index="{{index}}"
                      data-minutes="{{item.timer}}"
                    >
                      <text class="timer-emoji">⏱️</text>
                      <text class="timer-btn-text">{{activeTimerStepIndex === index ? (timerSecondsLeft > 0 ? '剩余 ' + formattedTimeLeft : '已完成！') : '开始计时 (' + item.timer + '分钟)'}}</text>
                    </view>
                  </view>
                  <view class="timeline-step-header" wx:else>
                    <text class="timeline-step-title">步骤 {{index + 1}}</text>
                  </view>
                  
                  <!-- Step description -->
                  <text class="timeline-step-desc margin-top-xs">{{item.desc}}</text>
                  
                  <!-- Step Image -->
                  <image class="timeline-step-image margin-top-sm" src="{{item.image}}" mode="widthFix" wx:if="{{item.image}}"></image>
                </view>
              </view>
            </view>
          </block>
        </view>
      </scroll-view>
      
      <!-- Bottom Add to Cart Bar -->
      <view class="detail-bottom-bar flex-row justify-between align-center">
        <view class="detail-bottom-price-info">
          <view class="price">
            <text class="symbol">¥</text>{{selectedRecipe.price}}
          </view>
        </view>
        
        <!-- Quantity Adjust / Add to Cart Button -->
        <view class="detail-action-button-area">
          <view class="detail-quantity-controller flex-row align-center" wx:if="{{cart[selectedRecipe.id]}}">
            <view class="detail-minus-btn" catchtap="onSubtractCart" data-id="{{selectedRecipe.id}}"></view>
            <text class="detail-quantity-num">{{cart[selectedRecipe.id].quantity}}</text>
            <view class="detail-plus-btn" catchtap="onAddCart" data-item="{{selectedRecipe}}"></view>
          </view>
          <button 
            class="btn-primary detail-add-cart-btn flex-row justify-center align-center" 
            bindtap="onAddCart" 
            data-item="{{selectedRecipe}}"
            wx:else
          >
            加入购物车
          </button>
        </view>
      </view>
    </block>
  </view>

  <!-- 8. Move to Category Modal -->
  <view class="modal-overlay" wx:if="{{showMoveCategoryModal}}" bindtap="closeMoveCategoryModal"></view>
  <view class="move-category-modal-card" wx:if="{{showMoveCategoryModal}}">
    <view class="modal-close" bindtap="closeMoveCategoryModal">×</view>
    <view class="modal-title">移动到分类</view>

    <block wx:if="{{movingRecipe}}">
      <view class="move-recipe-hint flex-row align-center">
        <image class="move-recipe-image" src="{{movingRecipe.image || '/assets/images/default_food.jpg'}}" mode="aspectFill" binderror="onImageError" data-type="recipe" data-id="{{movingRecipe.id}}"></image>
        <text class="move-recipe-name">{{movingRecipe.name}}</text>
      </view>
    </block>

    <scroll-view class="move-category-list" scroll-y>
      <view
        class="move-category-item {{movingRecipe && movingRecipe.categoryId === item.id ? 'current' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        bindtap="onMoveCategorySelect"
        data-id="{{item.id}}"
      >
        <text class="move-category-name">{{item.name}}</text>
        <text class="move-category-current-badge" wx:if="{{movingRecipe && movingRecipe.categoryId === item.id}}">当前</text>
      </view>
    </scroll-view>
  </view>
  <!-- Custom Profile Modal for New Users -->
  <view class="modal-overlay" wx:if="{{showProfileModal}}"></view>
  <view class="profile-modal-card flex-col align-center {{showProfileModal ? 'scale-in' : ''}}" wx:if="{{showProfileModal}}">
    <view class="modal-close" bindtap="onCloseProfileModal">×</view>
    <view class="modal-title">完善个人信息</view>
    <view class="profile-modal-subtitle">为了方便在群组内协作与拼单，请确认您的微信头像和昵称</view>

    <view class="profile-modal-form">
      <view class="profile-avatar-section flex-col align-center">
        <button class="profile-avatar-wrapper" open-type="chooseAvatar" bindchooseavatar="onChooseProfileAvatar">
          <image class="profile-avatar-img" src="{{profileAvatarUrl || '/assets/images/default_avatar.png'}}" mode="aspectFill" binderror="onImageError" data-type="profileAvatar"></image>
          <view class="profile-avatar-edit-badge">
            <text class="edit-badge-icon">📷</text>
          </view>
        </button>
        <text class="profile-avatar-tip">点击选择微信头像</text>
      </view>

      <view class="profile-input-item flex-row">
        <text class="profile-input-label">昵称</text>
        <input type="nickname" class="profile-input-field" placeholder="请选择或输入昵称" value="{{profileNickName}}" bindblur="onInputProfileNickname" bindinput="onInputProfileNickname"/>
      </view>
    </view>

    <view class="profile-modal-actions flex-row">
      <button class="btn-profile-cancel flex-1" bindtap="onCloseProfileModal">暂不设置</button>
      <button class="btn-profile-confirm flex-1" bindtap="onSubmitProfile">确认并保存</button>
    </view>
  </view>

  <!-- 9. Splash Loading Screen Overlay -->
  <view class="splash-container {{splashFadeOut ? 'fade-out' : ''}}" wx:if="{{showSplash}}" catchtouchmove="preventTouchMove">
    <view class="splash-content flex-col align-center justify-between">
      <!-- Top spacing -->
      <view class="splash-spacer"></view>
      
      <!-- Center branding section -->
      <view class="splash-branding flex-col align-center">
        <image class="splash-logo" src="/assets/images/logo.jpg" mode="aspectFill"></image>
        <text class="splash-title">Q 菜单</text>
        <text class="splash-subtitle">用心做每一道菜</text>
      </view>
      
      <!-- Bottom loading indicator & footer -->
      <view class="splash-footer flex-col align-center">
        <!-- Bouncing dots loading animation -->
        <view class="loading-dots flex-row justify-center">
          <view class="dot dot-1"></view>
          <view class="dot dot-2"></view>
          <view class="dot dot-3"></view>
        </view>
        <text class="splash-loading-text">正在载入美味数据...</text>
        <text class="splash-copyright">© 2026 Q 菜单. All rights reserved.</text>
      </view>
    </view>
  </view>
</view>
