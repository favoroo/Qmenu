.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background-color: #f7fafc;
}

/* 1. Header Styles */
.header-section {
  background-color: #ffffff;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
  z-index: 10;
}



.btn-add-recipe {
  font-size: 24rpx;
  color: #ffffff;
  background-color: var(--primary-color);
  border: 1rpx solid var(--primary-color);
  padding: 8rpx 28rpx;
  border-radius: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  transition: all 0.2s ease;
}

.btn-add-recipe:active {
  background-color: var(--primary-dark);
  border-color: var(--primary-dark);
  opacity: 0.95;
}

.add-icon {
  margin-right: 6rpx;
  font-size: 26rpx;
  font-weight: bold;
}

.search-bar-container {
}

.search-bar {
  background-color: var(--bg-light);
  border: 2rpx solid var(--border-color);
  border-radius: 30rpx;
  padding: 12rpx 24rpx;
  height: 68rpx;
}

.search-input {
  flex: 1;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--text-main);
}

.search-placeholder {
  color: var(--text-light);
}

/* 2. Main Content Split View */
.main-content {
  flex: 1;
  overflow: hidden;
}

/* Left Sidebar Categories */
.category-sidebar {
  width: 180rpx;
  height: 100%;
  background-color: #f7fafc;
  border-right: 1rpx solid var(--border-color);
}

.category-item {
  padding: 36rpx 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-sub);
  position: relative;
  transition: all 0.2s ease;
}

.category-item.active {
  color: var(--primary-color);
  background-color: #ffffff;
  font-weight: bold;
}

.category-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 30%;
  height: 40%;
  width: 8rpx;
  background-color: var(--primary-color);
  border-radius: 0 4rpx 4rpx 0;
}

.category-manage-btn {
  margin: 24rpx 20rpx 30rpx;
  padding: 14rpx 0;
  font-size: 22rpx;
  color: var(--primary-color);
  background-color: var(--primary-light);
  border: 1rpx solid var(--primary-soft);
  border-radius: 32rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.category-manage-btn:active {
  background-color: var(--primary-soft);
  transform: scale(0.96);
}

.category-manage-btn .manage-icon {
  font-size: 22rpx;
  margin-right: 6rpx;
  opacity: 0.8;
}

/* Right Recipe Cards Scroll */
.recipe-list {
  height: 100%;
  background-color: #ffffff;
  padding: 0 32rpx 0 20rpx;
}

.category-title-header {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
  padding: 24rpx 0 12rpx 0;
}

.empty-category {
  padding: 20rpx 0 30rpx 0;
}

.empty-category-text {
  font-size: 22rpx;
  color: var(--text-light);
}

.recipes-container {
  padding-bottom: 40rpx;
}

.recipe-card {
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.recipe-image {
  width: 180rpx;
  height: 135rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background-color: var(--bg-light);
  transition: transform 0.3s ease;
}

.recipe-card:active .recipe-image {
  transform: scale(1.03);
}

.recipe-info {
  height: 135rpx;
  padding: 2rpx 0;
}

.recipe-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 6rpx;
}

.recipe-desc {
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.3;
}

.recipe-bottom {
  margin-top: 8rpx;
}

.recipe-price {
  color: var(--danger-color);
  font-weight: bold;
}

.price-symbol {
  font-size: 22rpx;
  margin-right: 2rpx;
}

.price-num {
  font-size: 32rpx;
}

/* Quantity Control Buttons */
.quantity-controller {
  display: flex;
  align-items: center;
}

.minus-btn {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border-color);
  background-color: #ffffff;
  transition: all 0.1s ease;
}

.minus-btn::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 18rpx;
  height: 4rpx;
  background-color: var(--text-sub);
  transform: translate(-50%, -50%);
  border-radius: 2rpx;
}

.quantity-num {
  font-size: 26rpx;
  min-width: 50rpx;
  text-align: center;
  font-weight: bold;
  color: var(--text-main);
  line-height: 44rpx;
}

.plus-btn {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: var(--primary-color);
  transition: all 0.1s ease;
}

.plus-btn::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 18rpx;
  height: 4rpx;
  background-color: #ffffff;
  transform: translate(-50%, -50%);
  border-radius: 2rpx;
}

.plus-btn::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 4rpx;
  height: 18rpx;
  background-color: #ffffff;
  transform: translate(-50%, -50%);
  border-radius: 2rpx;
}

.minus-btn:active, .plus-btn:active {
  opacity: 0.6;
  transform: scale(0.9);
}

/* Empty State */
.empty-state {
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-light);
  margin-top: 20rpx;
}

/* 3. Floating Random Wheel Button */
.floating-random-btn {
  position: fixed;
  right: 32rpx;
  bottom: 160rpx;
  z-index: 99;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(240, 245, 255, 0.95) 100%);
  backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(37, 99, 235, 0.25);
  box-shadow: 0 8rpx 32rpx rgba(37, 99, 235, 0.15), 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 2rpx;
  transition: all 0.2s ease;
  animation: float-soft 3s infinite ease-in-out;
}

.floating-random-btn:active {
  background: linear-gradient(135deg, rgba(240, 245, 255, 0.95) 0%, rgba(225, 235, 255, 0.95) 100%);
  border-color: rgba(37, 99, 235, 0.4);
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.1);
  opacity: 0.95;
}

.random-icon {
  font-size: 38rpx;
  line-height: 1;
}

.random-text {
  font-size: 18rpx;
  font-weight: 600;
  color: var(--primary-color);
  letter-spacing: 0.5rpx;
  line-height: 1.2;
}

/* 4. Bottom Dock Cart Bar */
.bottom-dock-container {
  position: fixed;
  bottom: 30rpx;
  left: 30rpx;
  right: 30rpx;
  height: 108rpx;
  background-color: var(--dock-bg);
  backdrop-filter: blur(20rpx);
  border-radius: 54rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
  z-index: 100;
  padding: 0 24rpx 0 32rpx;
  justify-content: space-between;
  display: flex;
  align-items: center;
}

.cart-icon-wrapper {
  cursor: pointer;
  display: flex;
  align-items: center;
}

.cart-icon-bg {
  width: 80rpx;
  height: 80rpx;
  background-color: var(--primary-color);
  border-radius: 50%;
  position: relative;
  margin-top: -15rpx;
  border: 6rpx solid #0F1B3D;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.cart-icon-img {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 40rpx;
  height: 40rpx;
  transform: translate(-50%, -50%);
  filter: brightness(0) invert(1); /* make it white */
  display: block;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background-color: var(--danger-color);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: bold;
  min-width: 34rpx;
  height: 34rpx;
  border-radius: 17rpx;
  border: 2rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.cart-badge.bump {
  animation: badge-pop 0.4s ease;
}

.cart-price-info {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.cart-total-price {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: bold;
  line-height: 1.2;
}

.cart-total-price .symbol {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.cart-subtext {
  color: var(--text-light);
  font-size: 20rpx;
  line-height: 1.2;
  margin-top: 2rpx;
}

.cart-action-buttons {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.btn-share-invite {
  margin: 0 !important;
  width: auto !important;
  white-space: nowrap !important;
  flex-shrink: 0 !important;
  background-color: transparent !important;
  color: var(--primary-light) !important;
  font-size: 24rpx !important;
  border: 2rpx solid var(--primary-color) !important;
  border-radius: 40rpx !important;
  padding: 0 24rpx !important;
  height: 72rpx !important;
  font-weight: 600 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
}

.btn-share-invite:active {
  background-color: var(--primary-tint) !important;
}

.btn-checkout {
  margin: 0 !important;
  width: auto !important;
  white-space: nowrap !important;
  flex-shrink: 0 !important;
  background: var(--primary-color) !important;
  color: #ffffff !important;
  font-size: 26rpx !important;
  font-weight: bold !important;
  border-radius: 40rpx !important;
  padding: 0 36rpx !important;
  height: 72rpx !important;
  border: none !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
}

.btn-checkout:active {
  opacity: 0.9 !important;
}

.btn-share-invite::after, .btn-checkout::after {
  display: none !important;
}

/* 5. Cart Drawer Sheets and Overlays */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 90;
  animation: overlay-fade-in 0.3s ease forwards;
}

@keyframes overlay-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.cart-popup-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 95;
  padding: 30rpx 40rpx 140rpx 40rpx;
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.08);
  transform: translateY(100%);
}

.cart-popup-sheet.slide-up {
  animation: cart-slide-up 0.35s cubic-bezier(0.25, 1, 0.5, 1) forwards;
}

@keyframes cart-slide-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.cart-sheet-header {
  border-bottom: 2rpx solid var(--border-color);
  padding-bottom: 20rpx;
  margin-bottom: 10rpx;
}

.cart-sheet-header .title {
  font-size: 30rpx;
  color: var(--text-main);
}

.cart-sheet-header .sub-count {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-left: 10rpx;
}

.cart-sheet-header .clear-btn {
  font-size: 24rpx;
  color: var(--text-sub);
}

.cart-items-scroll {
  max-height: 450rpx;
}

.cart-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.cart-item .name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.cart-item .price {
  font-size: 24rpx;
  color: var(--danger-color);
  margin-top: 4rpx;
}

/* 6. Random Modal styling */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 1000;
}

.random-modal-card {
  position: fixed;
  top: 45%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  background-color: #ffffff;
  border-radius: 36rpx;
  padding: 48rpx;
  z-index: 1001;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.3);
}

.modal-close {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  font-size: 40rpx;
  color: var(--text-light);
  line-height: 1;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-top: 10rpx;
  margin-bottom: 30rpx;
  text-align: center;
}

.random-count-selector {
  width: 100%;
  margin-bottom: 32rpx;
}

.selector-label {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-right: 16rpx;
  white-space: nowrap;
}

.selector-options {
  background-color: var(--bg-light);
  border-radius: 20rpx;
  padding: 4rpx;
  border: 1rpx solid var(--border-color);
  display: flex;
  flex-direction: row;
}

.selector-option {
  min-width: 68rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-sub);
  transition: all 0.2s ease;
}

.selector-option.active {
  background-color: var(--primary-color);
  color: #ffffff;
  font-weight: bold;
}

.random-category-section {
  width: 100%;
  margin-bottom: 24rpx;
}

.random-category-header {
  margin-bottom: 16rpx;
}

.random-category-toggle {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
  padding: 4rpx 16rpx;
}

.random-category-toggle.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.random-category-chips {
  width: 100%;
  max-height: 200rpx;
  overflow-y: auto;
}

.random-category-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 24rpx;
  margin: 0 12rpx 12rpx 0;
  font-size: 24rpx;
  color: var(--text-sub);
  background-color: var(--bg-light);
  border: 1rpx solid var(--border-color);
  border-radius: 28rpx;
  transition: all 0.2s ease;
  white-space: nowrap;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.random-category-chip.active {
  background-color: var(--primary-color);
  color: #ffffff;
  border-color: var(--primary-color);
  font-weight: 500;
}

.random-category-chip.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.random-pool-count {
  font-size: 22rpx;
  color: var(--text-light);
  text-align: center;
  margin-top: 8rpx;
}

.rolling-box {
  width: 100%;
  background-color: var(--primary-light);
  border-radius: 32rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(37, 99, 235, 0.12);
  margin-bottom: 40rpx;
  min-height: 340rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.rolling-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  width: 100%;
  gap: 20rpx;
}

.rolling-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.rolling-image {
  border-radius: 50%;
  background-color: #ffffff;
  box-shadow: var(--card-shadow);
}

.rolling-name {
  font-weight: bold;
  color: var(--primary-color);
}

/* For single layout */
.single-layout .rolling-item {
  width: 100%;
}
.single-layout .rolling-image {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 24rpx;
}
.single-layout .rolling-name {
  font-size: 36rpx;
  text-align: center;
}

/* For grid layout (2, 3, 4 items) */
.grid-2 .rolling-item {
  width: 45%;
}
.grid-2 .rolling-image {
  width: 130rpx;
  height: 130rpx;
  margin-bottom: 16rpx;
}
.grid-2 .rolling-name {
  font-size: 28rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

.grid-3 .rolling-item {
  width: 30%;
}
.grid-3 .rolling-image {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 12rpx;
}
.grid-3 .rolling-name {
  font-size: 24rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

.grid-4 .rolling-item {
  width: 45%;
}
.grid-4 .rolling-image {
  width: 110rpx;
  height: 110rpx;
  margin-bottom: 12rpx;
}
.grid-4 .rolling-name {
  font-size: 26rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

.btn-roll-trigger {
  width: 100%;
  background: var(--primary-color);
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  padding: 24rpx 0;
  border: none;
  box-shadow: var(--btn-shadow);
}

.btn-roll-trigger.disabled {
  background: #cbd5e0;
  box-shadow: none;
}

.btn-roll-confirm {
  width: 100%;
  background-color: #ffffff;
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  padding: 24rpx 0;
  margin-top: 20rpx;
  border: none;
}

/* Animations */
@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10px);
  }
}

.animate-bounce {
  animation: bounce 2s infinite ease-in-out;
}

.rotate-animation {
  animation: rotate 0.5s infinite linear;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.rolling-text {
  animation: pulse 0.2s infinite ease-in-out;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 0.7; }
  50% { transform: scale(1.05); opacity: 1; }
}

/* Add Recipe Button at the bottom of recipe list */
.bottom-add-recipe-wrapper {
  padding: 30rpx 0;
  width: 100%;
  display: flex;
  justify-content: center;
}

.btn-add-recipe-bottom {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 48rpx;
  height: 64rpx;
  border: 2rpx dashed var(--primary-color);
  background-color: var(--primary-light);
  color: var(--primary-color);
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.btn-add-recipe-bottom:active {
  background-color: var(--primary-tint);
}

/* ==========================================================================
   7. 菜谱详情弹窗 (Recipe Detail Modal & Timers)
   ========================================================================== */
.detail-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(10px);
  z-index: 999;
  animation: detail-fade-in 0.3s ease forwards;
}

.detail-popup-sheet {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 92vh;
  background-color: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  z-index: 1000;
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  animation: detail-slide-up 0.38s cubic-bezier(0.25, 1, 0.5, 1) forwards;
}

@keyframes detail-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes detail-slide-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.detail-close-btn {
  position: absolute;
  right: 32rpx;
  top: 32rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.3);
  color: #ffffff;
  font-size: 38rpx;
  z-index: 1010;
  font-weight: 300;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.15);
  transition: all 0.2s ease;
}

.detail-close-btn:active {
  background-color: rgba(0, 0, 0, 0.5);
  transform: scale(0.9);
}

.detail-content-scroll {
  width: 100%;
  height: 100%;
}

.detail-cover-image {
  width: 100%;
  height: 562rpx;
  aspect-ratio: 4 / 3;
  background-color: var(--bg-light);
}

.detail-info-container {
  padding: 40rpx 36rpx 180rpx 36rpx;
}

.detail-title-row {
  width: 100%;
}

.detail-name {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-main);
  line-height: 1.3;
}

.detail-category-badge {
  background-color: var(--primary-light);
  color: var(--primary-color);
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-left: 20rpx;
  display: inline-block;
  white-space: nowrap;
}

.detail-price-row {
  color: var(--danger-color);
  font-weight: bold;
}

.detail-price-symbol {
  font-size: 28rpx;
  margin-right: 4rpx;
}

.detail-price-num {
  font-size: 44rpx;
}

.detail-divider {
  height: 1rpx;
  background: linear-gradient(to right, transparent, var(--border-color) 20%, var(--border-color) 80%, transparent);
  margin: 36rpx 0;
  width: 100%;
}

.detail-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 20rpx;
}

.private-badge {
  font-size: 18rpx;
  color: var(--text-light);
  background-color: var(--bg-light);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: normal;
  border: 1rpx solid var(--border-color);
}

.detail-desc-box {
  width: 100%;
}

.detail-desc-text {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.5;
  display: block;
}

/* 用料表格样式 */
.detail-materials-table {
  width: 100%;
  background-color: var(--bg-light);
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.detail-material-row {
  width: 100%;
  padding: 18rpx 0;
  border-bottom: 1rpx dashed rgba(226, 232, 240, 0.6);
}

.detail-material-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.detail-material-row:first-child {
  padding-top: 0;
}

.detail-mat-name {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
}

.detail-mat-dots {
  border-bottom: 1rpx dotted rgba(148, 163, 184, 0.2);
  margin: 0 16rpx;
  height: 20rpx;
}

.detail-mat-weight {
  font-size: 28rpx;
  color: var(--text-sub);
  font-weight: 600;
}

/* 步骤时间轴样式 */
.detail-steps-timeline {
  width: 100%;
  margin-top: 10rpx;
}

.detail-step-timeline-item {
  width: 100%;
}

.timeline-left {
  position: relative;
  width: 50rpx;
  margin-right: 24rpx;
  align-self: stretch;
}

.timeline-node {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: var(--primary-color);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  z-index: 2;
  box-shadow: 0 2rpx 8rpx rgba(37, 99, 235, 0.25);
}

.timeline-line {
  position: absolute;
  top: 44rpx;
  bottom: 0;
  left: 21rpx;
  width: 2rpx;
  background-color: var(--border-color);
  z-index: 1;
}

.timeline-right {
  padding-bottom: 30rpx;
}

.timeline-step-header {
  width: 100%;
  height: 48rpx;
  display: flex;
  align-items: center;
}

.timeline-step-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
  line-height: 48rpx;
}

/* 交互烹饪定时器 */
.interactive-timer-btn {
  background-color: var(--primary-light);
  color: var(--primary-color);
  border: 1rpx solid rgba(37, 99, 235, 0.25);
  padding: 0 18rpx;
  height: 40rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  transition: all 0.25s ease;
  box-shadow: 0 2rpx 6rpx rgba(37, 99, 235, 0.06);
  margin-left: auto;
  flex-shrink: 0;
  white-space: nowrap;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.interactive-timer-btn:active {
  transform: scale(0.95);
}

.timer-emoji {
  font-size: 22rpx;
  margin-right: 6rpx;
  line-height: 1;
}

.timer-btn-text {
  line-height: 1;
}

.interactive-timer-btn.running {
  background-color: #FEF3C7;
  color: #D97706;
  border-color: rgba(217, 119, 6, 0.35);
  animation: pulse-timer 1.5s infinite ease-in-out;
}

.interactive-timer-btn.finished {
  background-color: #DEF7EC;
  color: #03543F;
  border-color: rgba(3, 84, 63, 0.35);
  box-shadow: 0 2rpx 10rpx rgba(3, 84, 63, 0.1);
}

@keyframes pulse-timer {
  0% { transform: scale(1); }
  50% { transform: scale(1.03); opacity: 0.85; }
  100% { transform: scale(1); }
}

.timeline-step-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.5;
  display: block;
}

.timeline-step-image {
  width: 100%;
  border-radius: 16rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.8);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

/* 底部加购条样式 */
.detail-bottom-bar {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 128rpx;
  background-color: #ffffff;
  border-top: 1rpx solid var(--border-color);
  padding: 0 40rpx 12rpx 40rpx; /* Leave space for home indicators */
  z-index: 1020;
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.03);
}

.detail-bottom-price-info {
  display: flex;
  flex-direction: column;
}

.detail-bottom-price-info .price {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--danger-color);
}

.detail-bottom-price-info .symbol {
  font-size: 28rpx;
  margin-right: 4rpx;
}

.detail-add-cart-btn {
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 0 48rpx;
  box-shadow: var(--btn-shadow);
  border: none;
}

.detail-quantity-controller {
  height: 80rpx;
}

.detail-minus-btn, .detail-plus-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  transition: opacity 0.2s ease;
}

.detail-minus-btn:active, .detail-plus-btn:active {
  opacity: 0.85;
}

.detail-minus-btn {
  border: 2rpx solid var(--border-color);
  background-color: #ffffff;
}

.detail-minus-btn::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20rpx;
  height: 4rpx;
  transform: translate(-50%, -50%);
  background-color: var(--text-sub);
  border-radius: 2rpx;
}

.detail-plus-btn {
  background-color: var(--primary-color);
}

.detail-plus-btn::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20rpx;
  height: 4rpx;
  transform: translate(-50%, -50%);
  background-color: #ffffff;
  border-radius: 2rpx;
}

.detail-plus-btn::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 4rpx;
  height: 20rpx;
  transform: translate(-50%, -50%);
  background-color: #ffffff;
  border-radius: 2rpx;
}

.detail-quantity-num {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
  margin: 0 24rpx;
}

/* ==========================================================================
   8. 移动到分类弹窗 (Move to Category Modal)
   ========================================================================== */
.move-category-modal-card {
  position: fixed;
  top: 45%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-height: 70vh;
  background-color: #ffffff;
  border-radius: 36rpx;
  padding: 48rpx;
  z-index: 1001;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.3);
  display: flex;
  flex-direction: column;
  animation: scale-in 0.25s cubic-bezier(0.25, 1, 0.5, 1) forwards;
}

@keyframes scale-in {
  from {
    transform: translate(-50%, -50%) scale(0.85);
    opacity: 0;
  }
  to {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
}

.move-recipe-hint {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: var(--bg-light);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid var(--border-color);
}

.move-recipe-image {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background-color: #ffffff;
}

.move-recipe-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.move-category-list {
  max-height: 50vh;
  flex: 1;
}

.move-category-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--border-color);
  transition: background-color 0.15s ease;
}

.move-category-item:last-child {
  border-bottom: none;
}

.move-category-item:active {
  background-color: var(--bg-light);
}

.move-category-item.current {
  background-color: var(--primary-light);
  border-radius: 16rpx;
  margin-bottom: 8rpx;
}

.move-category-name {
  font-size: 30rpx;
  color: var(--text-main);
  font-weight: 500;
}

.move-category-item.current .move-category-name {
  color: var(--primary-color);
  font-weight: 600;
}

.move-category-current-badge {
  font-size: 22rpx;
  color: var(--primary-color);
  background-color: var(--primary-soft);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

/* Group Selector Bar Styles */
.group-bar {
  background-color: #ffffff;
  padding: 16rpx 28rpx;
  border-bottom: 1rpx solid var(--border-color);
  z-index: 11;
  position: relative;
}

.group-picker-wrapper {
  flex: 1;
}

.group-picker {
  display: inline-flex;
}

.group-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary-color);
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow-down {
  font-size: 18rpx;
  color: var(--text-light);
  margin-left: 10rpx;
}

.group-actions {
  flex-shrink: 0;
}

.group-manage-btn {
  font-size: 24rpx;
  color: var(--primary-color);
  border: 1rpx solid var(--primary-color);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* Empty Group Guide State */
.empty-group {
  flex: 1;
  background-color: #ffffff;
  padding: 100rpx 50rpx;
  text-align: center;
}

.empty-group-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 70rpx;
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  font-size: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
}

.empty-group-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 20rpx;
}

.empty-group-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
  margin-bottom: 50rpx;
  max-width: 500rpx;
}

.recipe-creator {
  font-size: 20rpx;
  color: var(--text-light);
  background-color: var(--bg-light);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: normal;
  margin-left: 10rpx;
}

/* === Skeleton Loading === */
.shimmer {
  background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 37%, #f1f5f9 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
  border-radius: 8rpx;
}
@keyframes shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}
.skeleton-sidebar {
  width: 180rpx;
  padding: 20rpx 0;
  background: #fff;
  border-right: 1rpx solid var(--border-color);
}
.skeleton-cat-item {
  width: 140rpx;
  height: 72rpx;
  margin: 0 20rpx 24rpx;
}
.skeleton-recipe-area {
  padding: 20rpx;
}
.skeleton-title {
  width: 200rpx;
  height: 36rpx;
  margin-bottom: 24rpx;
}
.skeleton-recipe-card {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.skeleton-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.skeleton-info {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.skeleton-line {
  height: 28rpx;
  border-radius: 6rpx;
}
.w60 { width: 60%; }
.w90 { width: 90%; }
.w30 { width: 30%; }

